module core_build_config_mod

   implicit none

   private
   public :: BUILD_ZERO_PHASE

   ! ZERO_PHASE CMake option: deterministic zero wavemaker phases for
   ! regression parity; .false. draws phases from RANDOM_NUMBER
   logical, parameter :: BUILD_ZERO_PHASE = @BUILD_ZERO_PHASE_F@

end module core_build_config_mod
