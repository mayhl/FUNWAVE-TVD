! allow(E001)
module test_wavemaker

   use mpi_f08
   use pFUnit
   use core_comm_mod, only: type_comm, new_comm
   use core_constants_mod, only: SP
   use core_env_mod, only: type_env, new_env
   use core_log_io_mod, only: new_log_writer
   use core_grid_mod, only: type_grid_2d
   use model_initial_mod, only: type_model_initial
   use model_breaking_mod, only: type_model_breaking
   use model_wavemaker_mod, only: type_model_wavemaker, read_wavemakers, &
                                  type_bnd_spectrum, bnd_seam_fraction, &
                                  DIR_CARTESIAN, cnoidal_harmonics
   use model_sponge_mod, only: FACE_W, FACE_E, FACE_S, FACE_N

   implicit none

   ! 40 columns across 4 ranks in x; 4 rows; dx = 1
   integer, parameter :: TEST_M = 40
   integer, parameter :: TEST_N = 4

   ! Module-level SP literals (gfortran 15 kind-suffix quirk, see test_sponge)
   real(SP), parameter :: DX_SP = 1.0_SP
   real(SP), parameter :: DEP_SP = 10.0_SP
   real(SP), parameter :: XWM_SP = 20.0_SP
   real(SP), parameter :: TOL_SP = 1.0e-6_SP

contains

   subroutine dummy_fix_lint()
   end subroutine dummy_fix_lint

   ! Minimal env (log only) -- new_env would re-init MPI and clash with
   ! the pFUnit-provided communicator (test_checkpoint pattern)
   subroutine open_env(this, env, comm)
      class(MpiTestMethod), intent(inout) :: this
      type(type_env), intent(inout) :: env
      type(type_comm), intent(inout) :: comm
      comm = new_comm(io_rank_id=0, comm_id=this%getMpiCommunicator())
      allocate (env%log)
      env%log = new_log_writer("test_wm", comm%is_io_node())
   end subroutine open_env

   ! WK_DATA2D file: nfreq=2, phases in the optional block.  Rows of
   ! dirs/amps/phases come from the caller so the same writer builds
   ! the 3-direction and pre-compacted 2-direction variants.
   subroutine write_data2d_file(fname, ndir, dirs, amps, phases)
      character(*), intent(in) :: fname
      integer, intent(in) :: ndir
      real(SP), intent(in) :: dirs(ndir), amps(2, ndir), phases(2, ndir)
      integer :: unit, i
      open (newunit=unit, file=fname, status='replace', action='write')
      write (unit, '(I0,1X,I0)') 2, ndir
      write (unit, '(F6.2)') 10.0_SP
      write (unit, '(F6.3)') 0.10_SP
      write (unit, '(F6.3)') 0.12_SP
      do i = 1, ndir
         write (unit, '(F8.2)') dirs(i)
      end do
      do i = 1, ndir
         write (unit, '(2F8.4)') amps(:, i)
      end do
      do i = 1, ndir
         write (unit, '(2F8.2)') phases(:, i)
      end do
      close (unit)
   end subroutine write_data2d_file

   subroutine init_data2d(this, wm, fname)
      class(MpiTestMethod), intent(inout) :: this
      type(type_model_wavemaker), intent(inout) :: wm
      character(*), intent(in) :: fname
      type(type_grid_2d) :: grid
      type(type_comm)    :: comm
      type(type_env)     :: env
      call open_env(this, env, comm)
      grid%M = TEST_M; grid%N = TEST_N
      grid%nx_proc = 1; grid%ny_proc = 1
      call grid%setup(comm, create_partition=.false.)
      call grid%init_spacing(dx0=DX_SP, dy0=DX_SP)
      wm%wavemaker_type = 'WK_DATA2D'
      wm%WaveCompFile = fname
      wm%Xc_WK = XWM_SP
      wm%DEP_WK = DEP_SP
      call wm%init_compute(grid, .false., env, -0.531_SP)
   end subroutine init_data2d

   ! ----------------------------------------------------------------
   ! WK_DATA2D phase pairing, positive control: when the dropped
   ! |dir| >= 60 direction is LAST, nothing shifts and the 3-direction
   ! file must reproduce the pre-compacted 2-direction file bitwise.
   ! ----------------------------------------------------------------
   @test(npes=[1])
   subroutine test_data2d_phase_dropped_last(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_model_wavemaker) :: wm3, wm2
      real(SP) :: amps(2, 3), phases(2, 3)

      amps(:, 1) = [0.10_SP, 0.08_SP]
      amps(:, 2) = [0.06_SP, 0.09_SP]
      amps(:, 3) = [0.05_SP, 0.05_SP]
      phases(:, 1) = [90.0_SP, 120.0_SP]
      phases(:, 2) = [150.0_SP, 210.0_SP]
      phases(:, 3) = [11.0_SP, 22.0_SP]
      call write_data2d_file('wk_d2d_last3.txt', 3, &
                             [0.0_SP, 30.0_SP, 70.0_SP], amps, phases)
      call write_data2d_file('wk_d2d_last2.txt', 2, &
                             [0.0_SP, 30.0_SP], amps(:, 1:2), phases(:, 1:2))

      call init_data2d(this, wm3, 'wk_d2d_last3.txt')
      call init_data2d(this, wm2, 'wk_d2d_last2.txt')

      @assertEqual(0.0_SP, maxval(abs(wm3%Cm - wm2%Cm)), TOL_SP)
      @assertEqual(0.0_SP, maxval(abs(wm3%Sm - wm2%Sm)), TOL_SP)

      call dummy_fix_lint()
   end subroutine test_data2d_phase_dropped_last

   ! ----------------------------------------------------------------
   ! WK_DATA2D phase pairing (ledger A7d, fixed at rung 3): with the
   ! dropped direction FIRST, the tuple filter keeps each phase column
   ! paired with its own direction, so the 3-direction file must
   ! reproduce the pre-compacted ground truth bitwise (legacy never
   ! compacted Phase2D -- survivors picked up the dropped phases).
   ! ----------------------------------------------------------------
   @test(npes=[1])
   subroutine test_data2d_phase_mispair_characterization(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_model_wavemaker) :: wm3, wm2
      real(SP) :: amps(2, 3), phases(2, 3)

      amps(:, 1) = [0.05_SP, 0.05_SP]
      amps(:, 2) = [0.10_SP, 0.08_SP]
      amps(:, 3) = [0.06_SP, 0.09_SP]
      phases(:, 1) = [30.0_SP, 60.0_SP]
      phases(:, 2) = [90.0_SP, 120.0_SP]
      phases(:, 3) = [150.0_SP, 210.0_SP]
      call write_data2d_file('wk_d2d_first3.txt', 3, &
                             [-70.0_SP, 0.0_SP, 30.0_SP], amps, phases)
      call write_data2d_file('wk_d2d_first2.txt', 2, &
                             [0.0_SP, 30.0_SP], amps(:, 2:3), phases(:, 2:3))

      call init_data2d(this, wm3, 'wk_d2d_first3.txt')
      call init_data2d(this, wm2, 'wk_d2d_first2.txt')

      @assertEqual(0.0_SP, maxval(abs(wm3%Cm - wm2%Cm)), TOL_SP)
      @assertEqual(0.0_SP, maxval(abs(wm3%Sm - wm2%Sm)), TOL_SP)

      call dummy_fix_lint()
   end subroutine test_data2d_phase_mispair_characterization

   subroutine init_single_dir(this, wm, wtype, flag)
      class(MpiTestMethod), intent(inout) :: this
      type(type_model_wavemaker), intent(inout) :: wm
      character(*), intent(in) :: wtype
      logical, intent(in) :: flag
      type(type_grid_2d) :: grid
      type(type_comm)    :: comm
      type(type_env)     :: env
      call open_env(this, env, comm)
      grid%M = TEST_M; grid%N = TEST_N
      grid%nx_proc = 1; grid%ny_proc = 1
      call grid%setup(comm, create_partition=.false.)
      call grid%init_spacing(dx0=DX_SP, dy0=DX_SP)
      wm%wavemaker_type = wtype
      wm%single_dir = flag
      wm%Xc_WK = XWM_SP
      wm%DEP_WK = DEP_SP
      wm%FreqPeak = 0.1_SP
      wm%FreqMin = 0.05_SP
      wm%FreqMax = 0.2_SP
      wm%Hmo = 0.1_SP
      wm%Nfreq = 12
      wm%ThetaPeak = 10.0_SP
      wm%Ntheta = 5
      wm%Sigma_Theta = 25.0_SP
      call wm%init_compute(grid, .false., env, -0.531_SP)
   end subroutine init_single_dir

   ! ----------------------------------------------------------------
   ! single_dir discretizer flag (rung 4): a TMA grid-family type with
   ! single_dir set must reproduce the legacy WK_NEW_IRR path bitwise
   ! (same density, ladder, direction interleave, and phase draw).
   ! ----------------------------------------------------------------
   @test(npes=[1])
   subroutine test_single_dir_matches_wk_new_irr(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_model_wavemaker) :: wm_new, wm_flag

      call init_single_dir(this, wm_new, 'WK_NEW_IRR', .false.)
      call init_single_dir(this, wm_flag, 'WK_IRR', .true.)

      @assertEqual(0.0_SP, maxval(abs(wm_new%Cm - wm_flag%Cm)), TOL_SP)
      @assertEqual(0.0_SP, maxval(abs(wm_new%Sm - wm_flag%Sm)), TOL_SP)

      call dummy_fix_lint()
   end subroutine test_single_dir_matches_wk_new_irr

   ! ----------------------------------------------------------------
   ! Rung-5 reader coverage: initial: coexists with a multi-entry
   ! wavemaker: sequence; entries keep their roles and the seed
   ! default derives from the entry index (entry 1 = plain 66).
   ! npes=[4]: new_env's collectives run over MPI_COMM_WORLD, so every
   ! rank of the executable must participate (test_model_setup pattern).
   ! ----------------------------------------------------------------
   @test(npes=[4])
   subroutine test_read_coexist_multi_entry(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_env) :: env
      type(type_model_initial) :: ini
      type(type_model_breaking) :: brk
      type(type_model_wavemaker), allocatable :: wms(:)

      call new_env(env, label='test_coexist', yaml_path='test_coexist.yaml', &
                   log_path='test_coexist.log')

      call ini%read_input(env)
      @assertTrue(ini%is_activated)
      @assertEqual('INI_SOLITARY', ini%ic_type)

      ! breaking gates the zone-override keys (main reads it first)
      call brk%read_input(env)
      call read_wavemakers(env, wms, brk)
      @assertEqual(2, size(wms))
      @assertTrue(wms(1)%boundary_candidate)
      @assertEqual('PENDING_BOUNDARY', wms(1)%wavemaker_type)
      @assertEqual('swell', wms(1)%name)
      @assertEqual(66, wms(1)%seed)
      @assertTrue(wms(1)%zero_phase)
      @assertFalse(wms(2)%boundary_candidate)
      @assertEqual('WK_REG', wms(2)%wavemaker_type)
      @assertEqual(67, wms(2)%seed)

      call dummy_fix_lint()
   end subroutine test_read_coexist_multi_entry

   ! ----------------------------------------------------------------
   ! Spatially-varying boundary feed.  Write a single-direction (theta=0)
   ! 2D spectrum at two anchors with different amplitudes, and a manifest
   ! placing them at y = 2 and y = 5 on an 8-cell face.  With theta = 0 the
   ! spatial ramp has no y term, so the per-frequency envelope
   ! sqrt(Cm_eta^2 + Sm_eta^2) equals the blended component amplitude at
   ! every cross-shore i — an exact readout of the alongshore blend and
   ! its end-clamps.  zero_phase makes the complex blend collapse to a
   ! linear amplitude interpolation.
   ! ----------------------------------------------------------------

   ! nfreq=2, ndir=1 (theta=0), NO phase block -> the energy-only path.
   subroutine write_spec2d_1dir(fname, a1, a2)
      character(*), intent(in) :: fname
      real(SP), intent(in) :: a1, a2
      integer :: unit
      open (newunit=unit, file=fname, status='replace', action='write')
      write (unit, '(I0,1X,I0)') 2, 1
      write (unit, '(F6.2)') 10.0_SP
      write (unit, '(F6.3)') 0.10_SP
      write (unit, '(F6.3)') 0.20_SP
      write (unit, '(F8.2)') 0.0_SP
      write (unit, '(2F10.5)') a1, a2
      close (unit)
   end subroutine write_spec2d_1dir

   subroutine init_bnd_varying(this, wm, manifest, face, absolute)
      class(MpiTestMethod), intent(inout) :: this
      type(type_model_wavemaker), intent(inout) :: wm
      character(*), intent(in) :: manifest
      integer, intent(in), optional :: face   ! fed face (default west/relaxation, axis = y)
      logical, intent(in), optional :: absolute   ! absolute direction frame (default face-relative)
      type(type_grid_2d) :: grid
      type(type_comm)    :: comm
      type(type_env)     :: env
      call open_env(this, env, comm)
      grid%M = 6; grid%N = 8
      grid%nx_proc = 1; grid%ny_proc = 1
      call grid%setup(comm, create_partition=.false.)
      call grid%init_spacing(dx0=DX_SP, dy0=DX_SP)
      wm%wavemaker_type = 'boundary'
      wm%WAVE_DATA_TYPE = 'DATA'
      wm%loclist_file = manifest
      wm%DepthWaveMaker = DEP_SP
      wm%zero_phase = .true.
      if (present(face)) wm%flather_face = face
      if (present(absolute)) then
         if (absolute) wm%dir_convention = DIR_CARTESIAN
      end if
      call wm%init_compute(grid, .false., env, -0.531_SP)
   end subroutine init_bnd_varying

   ! Clamped linear reference blend (must mirror interp_weight).
   pure function expect_blend(y, yl, al, yh, ah) result(v)
      real(SP), intent(in) :: y, yl, al, yh, ah
      real(SP) :: v, w
      w = max(0.0_SP, min(1.0_SP, (y - yl)/(yh - yl)))
      v = (1.0_SP - w)*al + w*ah
   end function expect_blend

   @test(npes=[1])
   subroutine test_bnd_varying_blend(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_model_wavemaker) :: wm
      integer :: unit, j, ic
      real(SP) :: y, e1, e2, env_ib, env_ie

      call write_spec2d_1dir('bv_A.txt', 0.05_SP, 0.06_SP)
      call write_spec2d_1dir('bv_B.txt', 0.15_SP, 0.12_SP)
      open (newunit=unit, file='bv_loc.txt', status='replace', action='write')
      write (unit, '(A)') '# y_loc  file'
      write (unit, '(A)') '2.0 bv_A.txt'
      write (unit, '(A)') '5.0 bv_B.txt'
      close (unit)

      call init_bnd_varying(this, wm, 'bv_loc.txt')

      ic = size(wm%Cm_eta, 1)/2      ! a mid cross-shore column
      do j = 1, size(wm%Cm_eta, 2)
         y = wm%ymk_wk(j)
         e1 = sqrt(wm%Cm_eta(ic, j, 1)**2 + wm%Sm_eta(ic, j, 1)**2)
         e2 = sqrt(wm%Cm_eta(ic, j, 2)**2 + wm%Sm_eta(ic, j, 2)**2)
         ! blended amplitude, clamped past the y = 2 and y = 5 anchors
         @assertEqual(expect_blend(y, 2.0_SP, 0.05_SP, 5.0_SP, 0.15_SP), e1, TOL_SP)
         @assertEqual(expect_blend(y, 2.0_SP, 0.06_SP, 5.0_SP, 0.12_SP), e2, TOL_SP)
         ! envelope is independent of the cross-shore column (theta = 0)
         env_ib = sqrt(wm%Cm_eta(1, j, 1)**2 + wm%Sm_eta(1, j, 1)**2)
         env_ie = sqrt(wm%Cm_eta(size(wm%Cm_eta, 1), j, 1)**2 &
                       + wm%Sm_eta(size(wm%Cm_eta, 1), j, 1)**2)
         @assertEqual(env_ib, env_ie, TOL_SP)
      end do

      call dummy_fix_lint()
   end subroutine test_bnd_varying_blend

   ! ----------------------------------------------------------------
   ! Coordinate omitted -> anchors distributed equispaced along the face
   ! (endpoints inclusive) in manifest order.  Two bare-filename anchors on
   ! the N = 8, dy = 1 face (L_face = 7) land at y = 0 and y = 7, so the
   ! envelope blends linearly across the whole span.
   ! ----------------------------------------------------------------
   @test(npes=[1])
   subroutine test_bnd_varying_equispaced(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_model_wavemaker) :: wm
      integer :: unit, j, ic
      real(SP) :: y, e1, e2

      call write_spec2d_1dir('bve_A.txt', 0.05_SP, 0.06_SP)
      call write_spec2d_1dir('bve_B.txt', 0.15_SP, 0.12_SP)
      open (newunit=unit, file='bve_loc.txt', status='replace', action='write')
      write (unit, '(A)') '# no coordinates -> equispaced in this order'
      write (unit, '(A)') 'bve_A.txt'
      write (unit, '(A)') 'bve_B.txt'
      close (unit)

      call init_bnd_varying(this, wm, 'bve_loc.txt')

      ic = size(wm%Cm_eta, 1)/2
      do j = 1, size(wm%Cm_eta, 2)
         y = wm%ymk_wk(j)
         e1 = sqrt(wm%Cm_eta(ic, j, 1)**2 + wm%Sm_eta(ic, j, 1)**2)
         e2 = sqrt(wm%Cm_eta(ic, j, 2)**2 + wm%Sm_eta(ic, j, 2)**2)
         ! equispaced anchors at y = 0 and y = 7 (L_face = (8-1)*1)
         @assertEqual(expect_blend(y, 0.0_SP, 0.05_SP, 7.0_SP, 0.15_SP), e1, TOL_SP)
         @assertEqual(expect_blend(y, 0.0_SP, 0.06_SP, 7.0_SP, 0.12_SP), e2, TOL_SP)
      end do

      call dummy_fix_lint()
   end subroutine test_bnd_varying_equispaced

   ! ----------------------------------------------------------------
   ! Face-aware blend axis: a S/N-fed feed must interpolate along x, not y.
   ! With flather_face = FACE_S and anchors placed along x (at x = 1 and
   ! x = 4), the per-frequency envelope must vary with the cross-shore
   ! column i (xmk_wk) and be CONSTANT down j — the mirror of the west
   ! case, and the only cover for the S/N -> x branch.
   ! ----------------------------------------------------------------
   @test(npes=[1])
   subroutine test_bnd_varying_face_axis(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_model_wavemaker) :: wm
      integer :: unit, i, j, jl
      real(SP) :: x, e_here, e_j1

      call write_spec2d_1dir('bvf_A.txt', 0.05_SP, 0.06_SP)
      call write_spec2d_1dir('bvf_B.txt', 0.15_SP, 0.12_SP)
      open (newunit=unit, file='bvf_loc.txt', status='replace', action='write')
      write (unit, '(A)') '1.0 bvf_A.txt'
      write (unit, '(A)') '4.0 bvf_B.txt'
      close (unit)

      call init_bnd_varying(this, wm, 'bvf_loc.txt', face=FACE_S)

      ! a Flather feed narrows Cm_/Sm_ to the fed line, so the bounds are
      ! the window, not 1:n
      jl = lbound(wm%Cm_eta, 2)
      do i = lbound(wm%Cm_eta, 1), ubound(wm%Cm_eta, 1)
         x = wm%xmk_wk(i)
         ! blend runs along x (the fed S face), clamped past x = 1 and x = 4
         e_here = sqrt(wm%Cm_eta(i, jl, 1)**2 + wm%Sm_eta(i, jl, 1)**2)
         @assertEqual(expect_blend(x, 1.0_SP, 0.05_SP, 4.0_SP, 0.15_SP), e_here, TOL_SP)
         ! and it is constant down j (no y dependence in the amplitude)
         do j = jl, ubound(wm%Cm_eta, 2)
            e_j1 = sqrt(wm%Cm_eta(i, j, 1)**2 + wm%Sm_eta(i, j, 1)**2)
            @assertEqual(e_here, e_j1, TOL_SP)
         end do
      end do

      call dummy_fix_lint()
   end subroutine test_bnd_varying_face_axis

   ! ----------------------------------------------------------------
   ! Face-relative frame: a theta = 0 feed must propagate INTO the domain
   ! on every face.  For a single direction Cm_u = (transfer cos theta) Cm_eta
   ! and Cm_v = (transfer sin theta) Cm_eta pointwise, so sum(Cm_u*Cm_eta)
   ! carries the sign of the boundary-normal velocity: +x for west, -x for
   ! east; sum(Cm_v*Cm_eta) is +y for south, -y for north.  Absolute frame
   ! leaves theta = 0 pointing +x on every face (east then radiates outward,
   ! sum(Cm_u*Cm_eta) > 0) — the control that the rotation is frame-gated.
   ! ----------------------------------------------------------------
   @test(npes=[1])
   subroutine test_bnd_face_relative_orientation(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_model_wavemaker) :: wm(4), wabs
      integer :: unit, k, faces(4)
      real(SP) :: s_u, s_v, s_in

      call write_spec2d_1dir('bo_A.txt', 0.08_SP, 0.05_SP)
      open (newunit=unit, file='bo_loc.txt', status='replace', action='write')
      write (unit, '(A)') '1.0 bo_A.txt'
      close (unit)

      ! inward-normal velocity sum must be positive on every face: +x west,
      ! -x east, +y south, -y north (sign folded into s_in below)
      faces = [FACE_W, FACE_E, FACE_S, FACE_N]
      do k = 1, 4
         call init_bnd_varying(this, wm(k), 'bo_loc.txt', face=faces(k))
         s_u = sum(wm(k)%Cm_u*wm(k)%Cm_eta)
         s_v = sum(wm(k)%Cm_v*wm(k)%Cm_eta)
         select case (faces(k))
         case (FACE_W)
            s_in = s_u
         case (FACE_E)
            s_in = -s_u
         case (FACE_S)
            s_in = s_v
         case default
            s_in = -s_v
         end select
         @assertTrue(s_in > 0.0_SP)
      end do

      ! absolute frame leaves an east feed pointing +x (outward), a control
      ! that the rotation is gated on the frame
      call init_bnd_varying(this, wabs, 'bo_loc.txt', face=FACE_E, absolute=.true.)
      s_u = sum(wabs%Cm_u*wabs%Cm_eta)
      @assertTrue(s_u > 0.0_SP)

      call dummy_fix_lint()
   end subroutine test_bnd_face_relative_orientation

   ! ----------------------------------------------------------------
   ! Periodic seam metric: two anchors at the domain ends carry the full
   ! discontinuity.  For amplitudes 0.05 and 0.15 (shared zero phase) the
   ! fraction is |0.05-0.15| / sqrt(0.5(0.05^2+0.15^2)) = 0.8944; equal
   ! anchors give exactly zero.
   ! ----------------------------------------------------------------
   @test(npes=[1])
   subroutine test_bnd_seam_fraction(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_bnd_spectrum) :: set

      set%nfreq = 1; set%ndir = 1; set%nloc = 2
      allocate (set%y_loc(2), set%per_ser(1), set%theta_ser(1))
      allocate (set%amp(1, 1, 2), set%phase(1, 1, 2))
      set%y_loc = [0.0_SP, 10.0_SP]
      set%per_ser = [10.0_SP]; set%theta_ser = [0.0_SP]
      set%phase = 0.0_SP

      set%amp(1, 1, 1) = 0.05_SP; set%amp(1, 1, 2) = 0.15_SP
      @assertEqual(0.894427_SP, bnd_seam_fraction(set, 0.0_SP, 10.0_SP), 1.0e-5_SP)

      set%amp(1, 1, 1) = 0.10_SP; set%amp(1, 1, 2) = 0.10_SP
      @assertEqual(0.0_SP, bnd_seam_fraction(set, 0.0_SP, 10.0_SP), 1.0e-6_SP)

      call dummy_fix_lint()
   end subroutine test_bnd_seam_fraction

   ! ----------------------------------------------------------------
   ! Cnoidal expansion: cn^2 runs 1 at the crest (phase 0) to 0 at the
   ! trough (phase pi), so the harmonic sum and its alternating sum differ
   ! by exactly H; the closure gives c = L/T.  The TK plunging paddle
   ! (H 0.1, h 0.4, T 5) sits deep in the cnoidal range.
   ! ----------------------------------------------------------------
   @test(npes=[1])
   subroutine test_cnoidal_harmonics_identities(this)
      class(MpiTestMethod), intent(inout) :: this
      real(SP), allocatable :: amps(:)
      real(SP) :: wl, c, m, crest, trough
      integer :: n, k

      call cnoidal_harmonics(0.1_SP, 0.4_SP, 5.0_SP, 64, 1.0e-6_SP, n, amps, wl, c, m)
      @assertTrue(n > 3)
      crest = sum(amps)
      trough = 0.0_SP
      do k = 1, n
         trough = trough + amps(k)*real((-1)**k, SP)
      end do
      @assertEqual(0.1_SP, crest - trough, tolerance=1.0e-4_SP)
      @assertTrue(m > 0.99_SP)
      @assertEqual(wl/5.0_SP, c, tolerance=1.0e-6_SP)
      ! longer than the linear 9.8 m, shorter than the solitary limit
      @assertTrue(wl > 9.8_SP .and. wl < 12.0_SP)
   end subroutine test_cnoidal_harmonics_identities

   ! no cnoidal solution in the Stokes range: a small short wave in deep water
   @test(npes=[1])
   subroutine test_cnoidal_harmonics_no_solution(this)
      class(MpiTestMethod), intent(inout) :: this
      real(SP), allocatable :: amps(:)
      real(SP) :: wl, c, m
      integer :: n

      call cnoidal_harmonics(0.01_SP, 10.0_SP, 1.0_SP, 64, 1.0e-6_SP, n, amps, wl, c, m)
      @assertEqual(0, n)
   end subroutine test_cnoidal_harmonics_no_solution

   ! ----------------------------------------------------------------
   ! source.depth absent: the generation depth is the bed mean under the
   ! box when the bed is flat there
   ! ----------------------------------------------------------------
   @test(npes=[1])
   subroutine test_source_depth_from_flat_bed(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_model_wavemaker) :: wm
      type(type_grid_2d) :: grid
      type(type_comm)    :: comm
      type(type_env)     :: env
      real(SP), allocatable :: depth(:, :)

      call open_env(this, env, comm)
      grid%M = TEST_M; grid%N = TEST_N
      grid%nx_proc = 1; grid%ny_proc = 1
      call grid%setup(comm, create_partition=.false.)
      call grid%init_spacing(dx0=DX_SP, dy0=DX_SP)
      allocate (depth(grid%lp%mloc, grid%lp%nloc), source=DEP_SP)
      wm%wavemaker_type = 'WK_REG'
      wm%Tperiod = 5.0_SP
      wm%AMP_WK = 0.05_SP
      wm%Xc_WK = XWM_SP
      wm%DEP_WK = 0.0_SP
      wm%depth_auto = .true.
      call wm%init_compute(grid, .false., env, -0.531_SP, depth)
      @assertEqual(DEP_SP, wm%DEP_WK, tolerance=TOL_SP)
   end subroutine test_source_depth_from_flat_bed

end module test_wavemaker
