module test_time
   use pFUnit
   use core_constants_mod, only: SP
   use core_comm_mod,           only: type_comm, new_comm
   use core_yaml_file_mod,      only: type_yaml_reader
   use core_simulation_time_mod, only: type_simulation_control
   implicit none

contains

   @test
   subroutine test_simulation_lifecycle()
      type(type_simulation_control) :: sim
      real(SP) :: dt = 0.1_SP
      sim%t_end = 0.3_SP
      sim%current_time = 0.0_SP

      ! Check advance
      call sim%advance(dt)
      @assertEqual(0.1_SP, sim%current_time, tolerance=1e-6_SP)
      @assertEqual(1, sim%step)

      ! Check finished
      call sim%advance(dt) ! 0.2
      call sim%advance(dt) ! 0.3
      @assertTrue(sim%is_finished())
   end subroutine test_simulation_lifecycle

   @test
   subroutine test_exact_termination()
      type(type_simulation_control) :: sim
      real(SP) :: dt = 0.5_SP
      sim%t_end = 0.5_SP
      sim%current_time = 0.0_SP

      call sim%advance(dt)
      @assertTrue(sim%is_finished())
   end subroutine test_exact_termination

   @test
   subroutine test_is_finished_boundary()
      type(type_simulation_control) :: sim
      sim%t_end = 1.0_SP
      sim%current_time = 0.99_SP
      @assertFalse(sim%is_finished())
      sim%current_time = 1.0_SP
      @assertTrue(sim%is_finished())
      sim%current_time = 1.01_SP
      @assertTrue(sim%is_finished())
   end subroutine test_is_finished_boundary

   ! init_from_yaml reads total_time from the 'time:' block;
   ! t_start defaults to 0.0 when absent.
   @test
   subroutine test_init_from_yaml()
      type(type_simulation_control) :: sim
      type(type_yaml_reader) :: reader
      type(type_comm) :: comm
      character(:), allocatable :: yaml_path

      comm = new_comm(io_rank_id=0)
      yaml_path = "test.yaml"
      call reader%init(yaml_path, comm)
      call sim%init_from_yaml(reader)

      @assertEqual(0.0_SP,   sim%t_start,      tolerance=1e-6_SP)
      @assertEqual(100.0_SP, sim%t_end,        tolerance=1e-5_SP)
      @assertEqual(0.0_SP,   sim%current_time, tolerance=1e-6_SP)
      @assertEqual(0,        sim%step)
   end subroutine test_init_from_yaml

end module test_time


