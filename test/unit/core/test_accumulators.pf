module test_accumulators
   use FUnit
   use core_constants_mod, only: SP
   use core_accumulators_mod, only: type_accumulator, FILL_VALUE, THR_ABOVE, THR_BELOW
   implicit none

contains

   ! ----------------------------------------------------------------
   ! mean: time-weighted -- (1.0*0.1 + 2.0*0.2) / 0.3 = 5/3
   ! ----------------------------------------------------------------
   @test
   subroutine test_mean_adaptive_dt()
      type(type_accumulator) :: acc
      real(SP), dimension(1, 1) :: val
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "eta")
      call acc%allocate_stat("mean")

      val(1, 1) = 1.0_SP; call acc%accumulate(val, 0.1_SP)
      val(1, 1) = 2.0_SP; call acc%accumulate(val, 0.2_SP)

      stat = acc%get_stat("mean")
      @assertEqual(5.0_SP/3.0_SP, stat(1, 1), tolerance=1e-5_SP)
   end subroutine test_mean_adaptive_dt

   ! ----------------------------------------------------------------
   ! reset clears sums and total_dt; next window starts fresh
   ! ----------------------------------------------------------------
   @test
   subroutine test_reset_window()
      type(type_accumulator) :: acc
      real(SP), dimension(1, 1) :: val
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "eta")
      call acc%allocate_stat("mean")

      val(1, 1) = 1.0_SP; call acc%accumulate(val, 1.0_SP)
      call acc%reset()
      val(1, 1) = 2.0_SP; call acc%accumulate(val, 1.0_SP)

      stat = acc%get_stat("mean")
      @assertEqual(2.0_SP, stat(1, 1), tolerance=1e-5_SP)
   end subroutine test_reset_window

   ! ----------------------------------------------------------------
   ! rms with non-uniform dt:
   !   x=0 @ dt=0.1, x=2 @ dt=0.9  (total_dt=1.0)
   !   E[x^2] = (0*0.1 + 4*0.9) = 3.6  ->  rms = sqrt(3.6)
   ! ----------------------------------------------------------------
   @test
   subroutine test_rms_adaptive_dt()
      type(type_accumulator) :: acc
      real(SP), dimension(1, 1) :: val
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "eta")
      call acc%allocate_stat("rms")

      val(1, 1) = 0.0_SP; call acc%accumulate(val, 0.1_SP)
      val(1, 1) = 2.0_SP; call acc%accumulate(val, 0.9_SP)

      stat = acc%get_stat("rms")
      @assertEqual(sqrt(3.6_SP), stat(1, 1), tolerance=1e-5_SP)
   end subroutine test_rms_adaptive_dt

   ! ----------------------------------------------------------------
   ! min tracking: running minimum over multiple steps
   ! ----------------------------------------------------------------
   @test
   subroutine test_min_running()
      type(type_accumulator) :: acc
      real(SP), dimension(1, 1) :: val
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "eta")
      call acc%allocate_stat("min")

      val(1, 1) = 5.0_SP; call acc%accumulate(val, 0.5_SP)
      val(1, 1) = -3.0_SP; call acc%accumulate(val, 0.5_SP)
      val(1, 1) = 2.0_SP; call acc%accumulate(val, 0.5_SP)

      stat = acc%get_stat("min")
      @assertEqual(-3.0_SP, stat(1, 1), tolerance=1e-6_SP)
   end subroutine test_min_running

   ! ----------------------------------------------------------------
   ! total_dt is updated even when only max is allocated
   ! ----------------------------------------------------------------
   @test
   subroutine test_total_dt_always_tracked()
      type(type_accumulator) :: acc
      real(SP), dimension(1, 1) :: val

      call acc%init(1, 1, "h")
      call acc%allocate_stat("max")

      val(1, 1) = 1.0_SP; call acc%accumulate(val, 0.3_SP)
      val(1, 1) = 2.0_SP; call acc%accumulate(val, 0.7_SP)

      @assertEqual(1.0_SP, acc%total_dt, tolerance=1e-6_SP)
   end subroutine test_total_dt_always_tracked

   ! ----------------------------------------------------------------
   ! rms: sqrt(E[x^2]) with uniform dt
   !   x = 3, 4 -> rms = sqrt((9+16)/2) = sqrt(12.5)
   ! ----------------------------------------------------------------
   @test
   subroutine test_rms()
      type(type_accumulator) :: acc
      real(SP), dimension(1, 1) :: val
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "u")
      call acc%allocate_stat("rms")

      val(1, 1) = 3.0_SP; call acc%accumulate(val, 1.0_SP)
      val(1, 1) = 4.0_SP; call acc%accumulate(val, 1.0_SP)

      stat = acc%get_stat("rms")
      @assertEqual(sqrt(12.5_SP), stat(1, 1), tolerance=1e-5_SP)
   end subroutine test_rms

   ! ----------------------------------------------------------------
   ! max/min: dt-independent running extrema
   ! ----------------------------------------------------------------
   @test
   subroutine test_max_min()
      type(type_accumulator) :: acc
      real(SP), dimension(1, 1) :: val
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "eta")
      call acc%allocate_stat("max")
      call acc%allocate_stat("min")

      val(1, 1) = 3.0_SP; call acc%accumulate(val, 0.05_SP)
      val(1, 1) = -1.0_SP; call acc%accumulate(val, 0.1_SP)
      val(1, 1) = 1.5_SP; call acc%accumulate(val, 0.025_SP)

      stat = acc%get_stat("max")
      @assertEqual(3.0_SP, stat(1, 1), tolerance=1e-6_SP)

      stat = acc%get_stat("min")
      @assertEqual(-1.0_SP, stat(1, 1), tolerance=1e-6_SP)
   end subroutine test_max_min

   ! ----------------------------------------------------------------
   ! std: about the window mean, dt-weighted, on a large offset --
   ! samples 100 +/- 0.5 with equal dt: mean 100, std 0.5.  The raw
   ! E[f^2]-E[f]^2 identity loses ~half the SP digits at offset 100;
   ! the shifted moments keep the answer tight
   ! ----------------------------------------------------------------
   @test
   subroutine test_std_shifted_offset()
      type(type_accumulator) :: acc
      real(SP), dimension(1, 1) :: val
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "eta")
      call acc%allocate_stat("std")

      val(1, 1) = 100.5_SP; call acc%accumulate(val, 0.1_SP)
      val(1, 1) = 99.5_SP; call acc%accumulate(val, 0.1_SP)

      stat = acc%get_stat("std")
      @assertEqual(0.5_SP, stat(1, 1), tolerance=1e-5_SP)
   end subroutine test_std_shifted_offset

   ! ----------------------------------------------------------------
   ! shifted mode: mean and rms reconstruct through the shift to the
   ! same values the unshifted path produces
   ! ----------------------------------------------------------------
   @test
   subroutine test_shifted_mean_rms_reconstruct()
      type(type_accumulator) :: acc
      real(SP), dimension(1, 1) :: val
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "eta")
      call acc%allocate_stat("mean")
      call acc%allocate_stat("rms")
      call acc%allocate_stat("std")   ! engages shifted accumulation

      val(1, 1) = 1.0_SP; call acc%accumulate(val, 0.1_SP)
      val(1, 1) = 2.0_SP; call acc%accumulate(val, 0.2_SP)

      stat = acc%get_stat("mean")
      @assertEqual(5.0_SP/3.0_SP, stat(1, 1), tolerance=1e-5_SP)
      stat = acc%get_stat("rms")
      ! E[f^2] = (1*0.1 + 4*0.2)/0.3 = 3
      @assertEqual(sqrt(3.0_SP), stat(1, 1), tolerance=1e-5_SP)
   end subroutine test_shifted_mean_rms_reconstruct

   ! ----------------------------------------------------------------
   ! reset re-captures the shift: window 2 anchored at its own first
   ! sample tracks a drifted mean without contaminating the variance
   ! ----------------------------------------------------------------
   @test
   subroutine test_std_reset_recaptures_shift()
      type(type_accumulator) :: acc
      real(SP), dimension(1, 1) :: val
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "eta")
      call acc%allocate_stat("std")

      val(1, 1) = 1.0_SP; call acc%accumulate(val, 0.1_SP)
      val(1, 1) = 3.0_SP; call acc%accumulate(val, 0.1_SP)
      call acc%reset()

      ! drifted window: 200 +/- 1, equal dt -> std 1
      val(1, 1) = 201.0_SP; call acc%accumulate(val, 0.1_SP)
      val(1, 1) = 199.0_SP; call acc%accumulate(val, 0.1_SP)

      stat = acc%get_stat("std")
      @assertEqual(1.0_SP, stat(1, 1), tolerance=1e-5_SP)
   end subroutine test_std_reset_recaptures_shift

   ! ----------------------------------------------------------------
   ! events: helper feeding one cell a sample series at unit dt, t = 0, 1, ...
   ! ----------------------------------------------------------------
   subroutine feed(acc, series, wet)
      type(type_accumulator), intent(inout) :: acc
      real(SP), intent(in) :: series(:)
      logical, intent(in), optional :: wet(:)
      real(SP) :: val(1, 1)
      logical :: w(1, 1)
      integer :: n
      do n = 1, size(series)
         val(1, 1) = series(n)
         if (present(wet)) then
            w(1, 1) = wet(n)
            call acc%accumulate(val, 1.0_SP, t=real(n - 1, SP), wet=w)
         else
            call acc%accumulate(val, 1.0_SP, t=real(n - 1, SP))
         end if
      end do
   end subroutine feed

   ! ----------------------------------------------------------------
   ! two events above 0.5: [1,2] and [4]; the trailing below sample closes
   ! the second -> count 2, first 1, last 4, duration 3, duration_max 2
   ! ----------------------------------------------------------------
   @test
   subroutine test_event_basic()
      type(type_accumulator) :: acc
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "h")
      call acc%allocate_stat("count")
      call acc%set_threshold(0.5_SP, THR_ABOVE)
      call feed(acc, [0.0_SP, 1.0_SP, 1.0_SP, 0.0_SP, 1.0_SP, 0.0_SP])

      stat = acc%get_stat("count")

      @assertEqual(2.0_SP, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("first_time")
      @assertEqual(1.0_SP, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("last_time")
      @assertEqual(4.0_SP, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("duration")
      @assertEqual(3.0_SP, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("duration_max")
      @assertEqual(2.0_SP, stat(1, 1), tolerance=1e-6_SP)
   end subroutine test_event_basic

   ! ----------------------------------------------------------------
   ! event log: the two events of test_event_basic as rows (onset, end,
   ! duration, peak, cell); a drain forgets them, the dropped count stays
   ! ----------------------------------------------------------------
   @test
   subroutine test_event_log_rows()
      type(type_accumulator) :: acc

      call acc%init(1, 1, "h")
      call acc%allocate_stat("count")
      call acc%set_threshold(0.5_SP, THR_ABOVE)
      call acc%enable_log(8)
      call feed(acc, [0.0_SP, 1.0_SP, 3.0_SP, 0.0_SP, 2.0_SP, 0.0_SP])

      @assertEqual(2, acc%n_events)
      @assertEqual(1.0_SP, acc%ev_t_on(1), tolerance=1e-6_SP)
      @assertEqual(3.0_SP, acc%ev_t_off(1), tolerance=1e-6_SP)
      @assertEqual(2.0_SP, acc%ev_dur(1), tolerance=1e-6_SP)
      @assertEqual(3.0_SP, acc%ev_peak(1), tolerance=1e-6_SP)
      @assertEqual(4.0_SP, acc%ev_t_on(2), tolerance=1e-6_SP)
      @assertEqual(2.0_SP, acc%ev_peak(2), tolerance=1e-6_SP)
      @assertEqual(1, acc%ev_i(2))
      @assertEqual(1, acc%ev_j(2))
      @assertEqual(0, acc%n_dropped)

      call acc%clear_events()
      @assertEqual(0, acc%n_events)
   end subroutine test_event_log_rows

   ! ----------------------------------------------------------------
   ! event log: the buffer starts at 1024 rows and doubles up to the cap;
   ! 1500 one-sample events under a cap of 4096 all land, none dropped
   ! ----------------------------------------------------------------
   @test
   subroutine test_event_log_grows()
      type(type_accumulator) :: acc
      real(SP) :: series(3000)
      integer :: n

      call acc%init(1, 1, "h")
      call acc%allocate_stat("count")
      call acc%set_threshold(0.5_SP, THR_ABOVE)
      call acc%enable_log(4096)
      do n = 1, 3000
         series(n) = merge(1.0_SP, 0.0_SP, mod(n, 2) == 1)
      end do
      call feed(acc, series)

      @assertEqual(1500, acc%n_events)
      @assertEqual(0, acc%n_dropped)
      @assertEqual(2996.0_SP, acc%ev_t_on(1499), tolerance=1e-6_SP)
   end subroutine test_event_log_grows

   ! ----------------------------------------------------------------
   ! event log: min_duration discards leave no row; a below threshold
   ! logs the minimum as the peak; rows over the cap are counted
   ! ----------------------------------------------------------------
   @test
   subroutine test_event_log_filters_and_cap()
      type(type_accumulator) :: acc

      call acc%init(1, 1, "h")
      call acc%allocate_stat("count")
      call acc%set_threshold(0.5_SP, THR_BELOW, min_duration=1.5_SP)
      call acc%enable_log(1)
      ! events below 0.5: [1] (1 s, discarded), [3,4] (2 s, logged), [6,7] (over the cap)
      call feed(acc, [1.0_SP, 0.2_SP, 1.0_SP, 0.1_SP, -0.4_SP, 1.0_SP, 0.3_SP, 0.0_SP, 1.0_SP])

      @assertEqual(1, acc%n_events)
      @assertEqual(3.0_SP, acc%ev_t_on(1), tolerance=1e-6_SP)
      @assertEqual(-0.4_SP, acc%ev_peak(1), tolerance=1e-6_SP)
      @assertEqual(1, acc%n_dropped)
   end subroutine test_event_log_filters_and_cap

   ! ----------------------------------------------------------------
   ! an open event is not committed; reset keeps it open and it lands
   ! whole in the window it closes in
   ! ----------------------------------------------------------------
   @test
   subroutine test_event_open_carries_over_reset()
      type(type_accumulator) :: acc
      real(SP), allocatable :: stat(:, :)
      real(SP) :: val(1, 1)

      call acc%init(1, 1, "h")
      call acc%allocate_stat("duration")
      call acc%set_threshold(0.5_SP, THR_ABOVE)
      call feed(acc, [1.0_SP, 1.0_SP])
      stat = acc%get_stat("count")
      @assertEqual(0.0_SP, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("first_time")
      @assertEqual(FILL_VALUE, stat(1, 1), tolerance=1e-6_SP)

      call acc%reset()
      val(1, 1) = 1.0_SP; call acc%accumulate(val, 1.0_SP, t=2.0_SP)
      val(1, 1) = 0.0_SP; call acc%accumulate(val, 1.0_SP, t=3.0_SP)
      stat = acc%get_stat("count")
      @assertEqual(1.0_SP, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("duration")
      @assertEqual(3.0_SP, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("first_time")
      @assertEqual(0.0_SP, stat(1, 1), tolerance=1e-6_SP)
   end subroutine test_event_open_carries_over_reset

   ! ----------------------------------------------------------------
   ! gap 1 step merges [1,2] and [4] into one event of duration 3; the
   ! gap sample itself is not duration
   ! ----------------------------------------------------------------
   @test
   subroutine test_event_gap_merge()
      type(type_accumulator) :: acc
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "h")
      call acc%allocate_stat("count")
      call acc%set_threshold(0.5_SP, THR_ABOVE, gap=1)
      call feed(acc, [0.0_SP, 1.0_SP, 1.0_SP, 0.0_SP, 1.0_SP, 0.0_SP, 0.0_SP, 0.0_SP])

      stat = acc%get_stat("count")

      @assertEqual(1.0_SP, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("duration")
      @assertEqual(3.0_SP, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("duration_max")
      @assertEqual(3.0_SP, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("last_time")
      @assertEqual(1.0_SP, stat(1, 1), tolerance=1e-6_SP)
   end subroutine test_event_gap_merge

   ! ----------------------------------------------------------------
   ! gap 1: the condition back one sample later continues the
   ! event ([1,1,0,1] = one event of duration 3); two samples away
   ! closes it ([1,0,0,1] = two events).  Independent of dt.
   ! ----------------------------------------------------------------
   @test
   subroutine test_event_gap_two_apart()
      type(type_accumulator) :: acc
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "h")
      call acc%allocate_stat("count")
      call acc%set_threshold(0.5_SP, THR_ABOVE, gap=1)
      call feed(acc, [1.0_SP, 1.0_SP, 0.0_SP, 1.0_SP, 0.0_SP, 0.0_SP, 1.0_SP, 0.0_SP, 0.0_SP])

      stat = acc%get_stat("count")
      @assertEqual(2.0_SP, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("duration_max")
      @assertEqual(3.0_SP, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("duration")
      @assertEqual(4.0_SP, stat(1, 1), tolerance=1e-6_SP)
   end subroutine test_event_gap_two_apart

   ! ----------------------------------------------------------------
   ! min_duration 1.5 s discards the one-sample event without a trace
   ! ----------------------------------------------------------------
   @test
   subroutine test_event_min_duration_discard()
      type(type_accumulator) :: acc
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "h")
      call acc%allocate_stat("first_time")
      call acc%set_threshold(0.5_SP, THR_ABOVE, min_duration=1.5_SP)
      call feed(acc, [0.0_SP, 1.0_SP, 0.0_SP, 1.0_SP, 1.0_SP, 0.0_SP])

      stat = acc%get_stat("count")

      @assertEqual(1.0_SP, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("first_time")
      @assertEqual(3.0_SP, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("duration")
      @assertEqual(2.0_SP, stat(1, 1), tolerance=1e-6_SP)
   end subroutine test_event_min_duration_discard

   ! ----------------------------------------------------------------
   ! dry samples never meet the condition; below direction and fill
   ! ----------------------------------------------------------------
   @test
   subroutine test_event_wet_only_below_and_fill()
      type(type_accumulator) :: acc
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "eta")
      call acc%allocate_stat("count")
      call acc%set_threshold(-0.5_SP, THR_BELOW)
      call feed(acc, [-1.0_SP, -1.0_SP, 0.0_SP, -1.0_SP, 0.0_SP], &
                wet=[.false., .false., .true., .true., .true.])

      stat = acc%get_stat("count")

      @assertEqual(1.0_SP, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("first_time")
      @assertEqual(3.0_SP, stat(1, 1), tolerance=1e-6_SP)

      call acc%init(1, 1, "eta")
      call acc%allocate_stat("last_time")
      call acc%set_threshold(0.5_SP, THR_ABOVE)
      call feed(acc, [0.0_SP, 0.0_SP])
      stat = acc%get_stat("last_time")
      @assertEqual(FILL_VALUE, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("duration")
      @assertEqual(0.0_SP, stat(1, 1), tolerance=1e-6_SP)
   end subroutine test_event_wet_only_below_and_fill

   ! ----------------------------------------------------------------
   ! max_time rides max: the time the running maximum was last raised;
   ! reset returns it to fill
   ! ----------------------------------------------------------------
   @test
   subroutine test_max_time()
      type(type_accumulator) :: acc
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "eta")
      call acc%allocate_stat("max")
      call acc%allocate_stat("max_time")
      call feed(acc, [0.1_SP, 0.9_SP, 0.3_SP, 0.9_SP])

      stat = acc%get_stat("max")

      @assertEqual(0.9_SP, stat(1, 1), tolerance=1e-6_SP)
      stat = acc%get_stat("max_time")
      @assertEqual(1.0_SP, stat(1, 1), tolerance=1e-6_SP)
      call acc%reset()
      stat = acc%get_stat("max_time")
      @assertEqual(FILL_VALUE, stat(1, 1), tolerance=1e-6_SP)
   end subroutine test_max_time

end module test_accumulators
