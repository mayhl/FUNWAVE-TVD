module test_accumulators
   use pFUnit
   use core_constants_mod, only: SP
   use core_accumulators_mod, only: type_accumulator
   implicit none

contains

   @test
   subroutine test_cumulative_mean()
      type(type_accumulator) :: acc
      real(SP), dimension(1, 1) :: val
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "test_mean")
      call acc%allocate_stat("mean")

      ! Mean: (1.0*0.1 + 2.0*0.2) / (0.1 + 0.2) = 0.3 / 0.3 = 1.6667
      val(1, 1) = 1.0_SP
      call acc%accumulate(val, 0.1_SP)
      val(1, 1) = 2.0_SP
      call acc%accumulate(val, 0.2_SP)

      stat = acc%get_stat("mean")
      @assertEqual(1.666667_SP, stat(1, 1), tolerance=1e-5_SP)
   end subroutine test_cumulative_mean

   @test
   subroutine test_resetting_window()
      type(type_accumulator) :: acc
      real(SP), dimension(1, 1) :: val
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "test_reset")
      call acc%allocate_stat("mean")

      val(1, 1) = 1.0_SP
      call acc%accumulate(val, 1.0_SP)

      call acc%reset()

      val(1, 1) = 2.0_SP
      call acc%accumulate(val, 1.0_SP)

      stat = acc%get_stat("mean")
      @assertEqual(2.0_SP, stat(1, 1), tolerance=1e-5_SP)
   end subroutine test_resetting_window

   @test
   subroutine test_ewma_mode()
      type(type_accumulator) :: acc
      real(SP), dimension(1, 1) :: val
      real(SP), allocatable :: stat(:, :)

      call acc%init(1, 1, "test_ewma")
      acc%alpha = 0.5_SP
      call acc%allocate_stat("ewma")

      ! S_n = 0.5 * 10.0 + (1 - 0.5) * 0.0 = 5.0
      val(1, 1) = 10.0_SP
      call acc%accumulate(val, 0.1_SP)

      ! S_n = 0.5 * 20.0 + (1 - 0.5) * 5.0 = 10.0 + 2.5 = 12.5
      val(1, 1) = 20.0_SP
      call acc%accumulate(val, 0.1_SP)

      stat = acc%get_stat("ewma")
      @assertEqual(12.5_SP, stat(1, 1), tolerance=1e-5_SP)
   end subroutine test_ewma_mode

end module test_accumulators
