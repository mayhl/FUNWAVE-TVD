! allow(E001)
module test_diagnostics
   use mpi_f08
   use pFUnit
   use core_constants_mod, only: SP, GRAV
   use core_comm_mod, only: type_comm, new_comm
   use core_grid_mod, only: type_grid_2d
   use core_field_registry_mod, only: type_field_registry
   use core_log_io_mod, only: type_log_writer, new_log_writer
   use core_diagnostics_mod, only: type_diagnostics, type_diag_metric, parse_metric, &
                                   RED_MAX, RED_COUNT, RED_MASS
   implicit none

contains

   ! 6x4 global grid split 2x1 in x: rank 0 owns i=1..3, rank 1 owns i=4..6.
   subroutine open_grid(this, grid, comm)
      class(MpiTestMethod), intent(inout) :: this
      type(type_grid_2d), intent(inout) :: grid
      type(type_comm), intent(inout) :: comm
      type(MPI_Comm) :: mcomm
      mcomm = this%getMpiCommunicator()
      comm = new_comm(io_rank_id=0, comm_id=mcomm)
      grid%M = 6
      grid%N = 4
      grid%nx_proc = 2
      grid%ny_proc = 1
      call grid%setup(comm, create_partition=.false.)
      call grid%init_spacing(dx0=0.5_SP, dy0=0.5_SP)
   end subroutine open_grid

   @test
   subroutine test_parse_metric()
      type(type_diag_metric) :: m
      logical :: ok
      call parse_metric("eta.max", m, ok)
      @assertTrue(ok)
      @assertEqual("eta", trim(m%var))
      @assertEqual(RED_MAX, m%kind)
      @assertFalse(m%guard)
      call parse_metric("froude_scale.count", m, ok)
      @assertTrue(ok)
      @assertTrue(m%below_one)
      @assertTrue(m%guard)
      @assertEqual(RED_COUNT, m%kind)
      call parse_metric("mass", m, ok)
      @assertTrue(ok)
      @assertEqual(RED_MASS, m%kind)
      @assertEqual("", trim(m%var))
      @assertEqual("m3", trim(m%units))
      call parse_metric("dt", m, ok)   ! a fixed column, not a metric
      @assertFalse(ok)
      call parse_metric("eta.median", m, ok)
      @assertFalse(ok)
      call parse_metric("eta", m, ok)
      @assertFalse(ok)
   end subroutine test_parse_metric

   ! Reductions across two ranks on a 6x4 grid with one dry column and a
   ! land cell: wet-only mass, global max, gate count/area, flooded area,
   ! and the wet mean.
   @test(npes=[2])
   subroutine test_reductions_two_ranks(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_comm) :: comm
      ! targets: the channel keeps pointers into all three
      type(type_grid_2d), target :: grid
      type(type_field_registry), target :: registry
      type(type_log_writer), target :: log
      type(type_diagnostics) :: diag
      type(type_diag_metric) :: metrics(7)
      real(SP), allocatable, target :: eta(:, :), u(:, :), v(:, :), h(:, :), depth(:, :), &
                                       mask(:, :), gate(:, :)
      integer :: i, j, ig, k
      logical :: ok

      call open_grid(this, grid, comm)
      log = new_log_writer("test", comm%is_io_node())
      associate (lp => grid%lp)
         allocate (eta(lp%mloc, lp%nloc), u(lp%mloc, lp%nloc), v(lp%mloc, lp%nloc), &
                   h(lp%mloc, lp%nloc), depth(lp%mloc, lp%nloc), mask(lp%mloc, lp%nloc), &
                   gate(lp%mloc, lp%nloc))
         eta = 0.0_SP; u = 0.0_SP; v = 0.0_SP; h = 1.0_SP; depth = 1.0_SP
         mask = 1.0_SP; gate = 1.0_SP
         do j = lp%jb, lp%je
            do i = lp%ib, lp%ie
               ig = grid%ibegin + i - lp%ib      ! global column 1..6
               eta(i, j) = real(ig, SP)          ! max = 6 (on rank 1)
               if (ig == 3) mask(i, j) = 0.0_SP  ! dry column: excluded everywhere
               if (ig == 5) depth(i, j) = -0.2_SP  ! land column, wet = flooded
               if (ig == 6 .and. j == lp%jb) gate(i, j) = 0.5_SP  ! one capped cell
            end do
         end do
      end associate
      call registry%register("eta", eta)
      call registry%register("u", u)
      call registry%register("v", v)
      call registry%register("h", h)
      call registry%register("depth", depth)
      call registry%register("mask", mask)
      call registry%register("froude_scale", gate)

      call parse_metric("mass", metrics(1), ok)
      call parse_metric("eta.max", metrics(2), ok)
      call parse_metric("froude_scale.count", metrics(3), ok)
      call parse_metric("froude_scale.area", metrics(4), ok)
      call parse_metric("flooded_area", metrics(5), ok)
      call parse_metric("eta.mean", metrics(6), ok)
      call parse_metric("mask.fraction", metrics(7), ok)
      ! no folder: reductions only, no files
      call diag%init(metrics, 0.0_SP, 1.0_SP, 0.01_SP, grid, registry, log, comm%is_io_node())
      call diag%step(0.0_SP, 0.0_SP, force=.true.)

      ! wet columns 1,2,4,5,6 x 4 rows, cell area 1/4: mass = (1+2+4+5+6)*4/4 = 18
      @assertEqual(18.0_SP, diag%metrics(1)%value, tolerance=1.0e-12_SP)
      @assertEqual(6.0_SP, diag%metrics(2)%value, tolerance=1.0e-12_SP)
      @assertEqual(1.0_SP, diag%metrics(3)%value, tolerance=1.0e-12_SP)
      @assertEqual(0.25_SP, diag%metrics(4)%value, tolerance=1.0e-12_SP)
      @assertEqual(1.0_SP, diag%metrics(5)%value, tolerance=1.0e-12_SP)
      @assertEqual(72.0_SP/20.0_SP, diag%metrics(6)%value, tolerance=1.0e-12_SP)
      @assertEqual(1.0_SP, diag%metrics(7)%value, tolerance=1.0e-12_SP)
      do k = 1, 7
         @assertEqual(trim(metrics(k)%name), trim(diag%metrics(k)%name))
      end do
      call diag%finalize()
      call grid%finalize()
   end subroutine test_reductions_two_ranks

end module test_diagnostics
