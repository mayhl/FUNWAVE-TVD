! allow(E001)
module test_time_utils

   use pFUnit
   use core_constants_mod, only: SP
   use core_time_utils_mod, only: type_timing_control
   implicit none(external)

contains

! Test for core_time_utils_mod
   @test
   subroutine test_timing_control_robustness()
      type(type_timing_control) :: timer
      real(SP) :: t
      logical :: triggered

      timer%interval = 1.0_SP
      timer%t_start = 1.0_SP ! Spin-up

      ! Check suppression before spin-up
      t = 0.5_SP
      @assertFalse(timer%should_trigger(t))

      ! Check trigger at boundary
      t = 1.0_SP
      @assertTrue(timer%should_trigger(t))

      ! Check suppression during interval
      t = 1.5_SP
      @assertFalse(timer%should_trigger(t))

      ! Check next trigger
      t = 2.0_SP
      @assertTrue(timer%should_trigger(t))
   end subroutine test_timing_control_robustness

end module test_time_utils
