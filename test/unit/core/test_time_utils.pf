! allow(E001)
module test_time_utils

   use pFUnit
   use core_constants_mod, only: SP
   use core_time_utils_mod, only: type_timing_control
   implicit none(external)

contains

! Test for core_time_utils_mod
   @test
   subroutine test_timing_control()

      type(type_timing_control) :: timer
      real(8) :: current_time
      logical :: triggered

      timer%interval = 1.0
      timer%t_start = 0.5

      ! Check spin-up
      current_time = 0.2
      triggered = timer%should_trigger(current_time)
      @assertFalse(triggered)

      ! Check trigger
      current_time = 0.6
      triggered = timer%should_trigger(current_time)
      @assertTrue(triggered)
      @assertEqual(timer%last_triggered, 0.6)

      ! Check interval
      current_time = 1.6
      triggered = timer%should_trigger(current_time)
      @assertTrue(triggered)
      @assertEqual(timer%last_triggered, 1.6)
   end subroutine test_timing_control

end module test_time_utils
