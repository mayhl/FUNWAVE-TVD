! allow(E001)
module test_output_channel

   use mpi_f08
   use pFUnit
   use netcdf
   use core_constants_mod,       only: SP, N_GHOST
   use core_comm_mod,            only: type_comm, new_comm
   use core_grid_mod,            only: type_grid_2d
   use core_field_registry_mod,  only: type_field_registry
   use core_output_channel_mod,  only: type_output_channel, type_var_meta, &
                                       open_diagnostics_file, close_diagnostics_file
   implicit none

   integer, parameter :: TEST_M = 8
   integer, parameter :: TEST_N = 4

contains

   subroutine dummy_fix_lint()
   end subroutine dummy_fix_lint

   ! 8x4 global grid split 2x1 in x: rank 0 owns i=1..4, rank 1 owns i=5..8.
   ! Node (ig, jg) sits at x = ig-1, y = jg-1.
   subroutine open_grid(this, grid, comm)
      class(MpiTestMethod), intent(inout) :: this
      type(type_grid_2d),   intent(inout) :: grid
      type(type_comm),      intent(inout) :: comm
      type(MPI_Comm) :: mcomm

      mcomm = this%getMpiCommunicator()
      comm  = new_comm(io_rank_id=0, comm_id=mcomm)
      grid%M       = TEST_M
      grid%N       = TEST_N
      grid%nx_proc = 2
      grid%ny_proc = 1
      call grid%setup(comm, create_partition=.false.)
      call grid%init_spacing(dx0=1.0_SP, dy0=1.0_SP)
   end subroutine open_grid

   ! Fill the interior of a ghost-inclusive field with 2*x + 3*y
   ! (linear, so bilinear interpolation reproduces it exactly).
   subroutine fill_linear(grid, fld)
      type(type_grid_2d), intent(in)    :: grid
      real(SP),           intent(inout) :: fld(:,:)
      integer  :: i, j
      real(SP) :: x, y

      do j = 1, grid%local_ny
         do i = 1, grid%local_nx
            x = real(grid%ibegin + i - 2, SP)
            y = real(grid%jbegin + j - 2, SP)
            fld(N_GHOST + i, N_GHOST + j) = 2.0_SP*x + 3.0_SP*y
         end do
      end do
   end subroutine fill_linear

   subroutine alloc_field(grid, fld)
      type(type_grid_2d),    intent(in)    :: grid
      real(SP), allocatable, intent(inout) :: fld(:,:)
      allocate(fld(grid%local_nx + 2*N_GHOST, grid%local_ny + 2*N_GHOST), &
               source=0.0_SP)
   end subroutine alloc_field

   ! ----------------------------------------------------------------
   ! field snapshot, ascii: eta_00001 holds the assembled global
   ! interior, one row of M values per J
   ! ----------------------------------------------------------------
   @test(npes=[2])
   subroutine test_field_snapshot_ascii(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_comm)             :: comm
      type(type_grid_2d)          :: grid
      type(type_field_registry)   :: reg
      type(type_output_channel)   :: ch
      real(SP), allocatable, target :: eta(:,:)
      character(32) :: vars(1)
      character(8)  :: stats(1)
      real(SP) :: cx(1), cy(1), row(TEST_M), x, y
      integer  :: i, j, unit

      call open_grid(this, grid, comm)
      call alloc_field(grid, eta)
      call fill_linear(grid, eta)
      call reg%register('eta', eta)

      vars(1) = 'eta';  stats(1) = ''
      cx = 0.0_SP;  cy = 0.0_SP
      call ch%init(id='snap_f', geom_type='field', variables=vars, n_vars=1, &
                   statistics=stats, n_stats=0, snapshot=.true., &
                   t_start=0.0_SP, interval=1.0_SP, &
                   result_folder='./', format='ascii', &
                   coords_x=cx, coords_y=cy, n_coords=0, grid=grid, comm=comm)

      call ch%step(0.0_SP, 0.5_SP, reg, comm)

      if (comm%is_io_node()) then
         open (newunit=unit, file='./eta_00001', status='old', action='read')
         do j = 1, TEST_N
            read (unit, *) row
            do i = 1, TEST_M
               x = real(i - 1, SP)
               y = real(j - 1, SP)
               @assertEqual(2.0_SP*x + 3.0_SP*y, row(i), tolerance=1e-4_SP)
            end do
         end do
         close (unit, status='delete')
      end if

      call ch%finalize()
      call reg%finalize()
      call dummy_fix_lint()
   end subroutine test_field_snapshot_ascii

   ! 8x4 global grid split 2x2: 4x2 tiles, offsets in BOTH directions
   ! (the MPI-IO subarray view must place j-offset tiles correctly).
   subroutine open_grid_2x2(this, grid, comm)
      class(MpiTestMethod), intent(inout) :: this
      type(type_grid_2d),   intent(inout) :: grid
      type(type_comm),      intent(inout) :: comm
      type(MPI_Comm) :: mcomm

      mcomm = this%getMpiCommunicator()
      comm  = new_comm(io_rank_id=0, comm_id=mcomm)
      grid%M       = TEST_M
      grid%N       = TEST_N
      grid%nx_proc = 2
      grid%ny_proc = 2
      call grid%setup(comm, create_partition=.false.)
      call grid%init_spacing(dx0=1.0_SP, dy0=1.0_SP)
   end subroutine open_grid_2x2

   ! ----------------------------------------------------------------
   ! field snapshot, binary: raw real(SP) stream of the (M, N) global
   ! interior array in Fortran order.  Written via collective MPI-IO
   ! (each rank puts its tile at its subarray offset), read back with
   ! a plain stream read — the bytes must match the gathered layout.
   ! ----------------------------------------------------------------
   @test(npes=[2])
   subroutine test_field_snapshot_binary(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_comm)             :: comm
      type(type_grid_2d)          :: grid
      type(type_field_registry)   :: reg
      type(type_output_channel)   :: ch
      real(SP), allocatable, target :: eta(:,:)
      character(32) :: vars(1)
      character(8)  :: stats(1)
      real(SP) :: cx(1), cy(1), glob(TEST_M, TEST_N), x, y
      integer  :: i, j, unit

      call open_grid(this, grid, comm)
      call alloc_field(grid, eta)
      call fill_linear(grid, eta)
      call reg%register('eta', eta)

      vars(1) = 'eta';  stats(1) = ''
      cx = 0.0_SP;  cy = 0.0_SP
      call ch%init(id='snap_b', geom_type='field', variables=vars, n_vars=1, &
                   statistics=stats, n_stats=0, snapshot=.true., &
                   t_start=0.0_SP, interval=1.0_SP, &
                   result_folder='./', format='binary', &
                   coords_x=cx, coords_y=cy, n_coords=0, grid=grid, comm=comm)

      call ch%step(0.0_SP, 0.5_SP, reg, comm)

      if (comm%is_io_node()) then
         open (newunit=unit, file='./eta_00001', access='stream', &
               form='unformatted', status='old', action='read')
         read (unit) glob
         close (unit, status='delete')
         do j = 1, TEST_N
            do i = 1, TEST_M
               x = real(i - 1, SP)
               y = real(j - 1, SP)
               @assertEqual(2.0_SP*x + 3.0_SP*y, glob(i,j), tolerance=1e-6_SP)
            end do
         end do
      end if

      call ch%finalize()
      call reg%finalize()
      call dummy_fix_lint()
   end subroutine test_field_snapshot_binary

   ! ----------------------------------------------------------------
   ! binary MPI-IO with a 2x2 decomposition: tiles carry non-zero
   ! offsets in BOTH i and j, so a misplaced subarray view scrambles
   ! the read-back values
   ! ----------------------------------------------------------------
   @test(npes=[4])
   subroutine test_field_snapshot_binary_2x2(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_comm)             :: comm
      type(type_grid_2d)          :: grid
      type(type_field_registry)   :: reg
      type(type_output_channel)   :: ch
      real(SP), allocatable, target :: eta(:,:)
      character(32) :: vars(1)
      character(8)  :: stats(1)
      real(SP) :: cx(1), cy(1), glob(TEST_M, TEST_N), x, y
      integer  :: i, j, unit

      call open_grid_2x2(this, grid, comm)
      call alloc_field(grid, eta)
      call fill_linear(grid, eta)
      call reg%register('eta', eta)

      vars(1) = 'eta';  stats(1) = ''
      cx = 0.0_SP;  cy = 0.0_SP
      call ch%init(id='snap_b4', geom_type='field', variables=vars, n_vars=1, &
                   statistics=stats, n_stats=0, snapshot=.true., &
                   t_start=0.0_SP, interval=1.0_SP, &
                   result_folder='./', format='binary', &
                   coords_x=cx, coords_y=cy, n_coords=0, grid=grid, comm=comm)

      call ch%step(0.0_SP, 0.5_SP, reg, comm)
      call comm%barrier()

      if (comm%is_io_node()) then
         open (newunit=unit, file='./eta_00001', access='stream', &
               form='unformatted', status='old', action='read')
         read (unit) glob
         close (unit, status='delete')
         do j = 1, TEST_N
            do i = 1, TEST_M
               x = real(i - 1, SP)
               y = real(j - 1, SP)
               @assertEqual(2.0_SP*x + 3.0_SP*y, glob(i,j), tolerance=1e-6_SP)
            end do
         end do
      end if

      call ch%finalize()
      call reg%finalize()
      call dummy_fix_lint()
   end subroutine test_field_snapshot_binary_2x2

   ! ----------------------------------------------------------------
   ! netcdf field snapshot: two flushes append two records of eta to
   ! the channel's data.nc; read back dims, coordinates, times, and
   ! the second frame through nf90
   ! ----------------------------------------------------------------
   @test(npes=[2])
   subroutine test_field_snapshot_netcdf(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_comm)             :: comm
      type(type_grid_2d)          :: grid
      type(type_field_registry)   :: reg
      type(type_output_channel)   :: ch
      real(SP), allocatable, target :: eta(:,:)
      character(32) :: vars(1)
      character(8)  :: stats(1)
      character(64) :: att
      type(type_var_meta) :: vmeta(1)
      real(SP) :: cx(1), cy(1), glob(TEST_M, TEST_N), tvals(2), x, y
      integer  :: i, j, ncid, varid, dimid, nlen

      call open_grid(this, grid, comm)
      call alloc_field(grid, eta)
      call fill_linear(grid, eta)
      call reg%register('eta', eta)

      vars(1) = 'eta';  stats(1) = ''
      vmeta(1)%units = 'm'
      vmeta(1)%standard_name = 'sea_surface_height_above_mean_sea_level'
      cx = 0.0_SP;  cy = 0.0_SP
      call ch%init(id='snap_nc', geom_type='field', variables=vars, n_vars=1, &
                   statistics=stats, n_stats=0, snapshot=.true., &
                   t_start=0.0_SP, interval=1.0_SP, &
                   result_folder='./', format='netcdf', &
                   coords_x=cx, coords_y=cy, n_coords=0, grid=grid, comm=comm, &
                   var_meta=vmeta)

      ! dt-accumulator trigger: interval=1.0 needs 1.0 s of accumulated
      ! dt between flushes, so walk t in dt steps (flushes at 0.0, 1.0)
      call ch%step(0.0_SP, 0.5_SP, reg, comm)
      eta = 2.0_SP*eta
      call ch%step(0.5_SP, 0.5_SP, reg, comm)
      call ch%step(1.0_SP, 0.5_SP, reg, comm)
      call ch%finalize()
      call comm%barrier()

      if (comm%is_io_node()) then
         @assertEqual(NF90_NOERR, nf90_open('./data.nc', NF90_NOWRITE, ncid))

         @assertEqual(NF90_NOERR, nf90_inq_dimid(ncid, 'time', dimid))
         @assertEqual(NF90_NOERR, nf90_inquire_dimension(ncid, dimid, len=nlen))
         @assertEqual(2, nlen)

         @assertEqual(NF90_NOERR, nf90_inq_varid(ncid, 'time', varid))
         @assertEqual(NF90_NOERR, nf90_get_var(ncid, varid, tvals))
         @assertEqual(1.0_SP, tvals(2), tolerance=1e-12_SP)

         @assertEqual(NF90_NOERR, nf90_inq_varid(ncid, 'eta', varid))
         att = ''
         @assertEqual(NF90_NOERR, nf90_get_att(ncid, varid, 'units', att))
         @assertEqual('m', trim(att))
         att = ''
         @assertEqual(NF90_NOERR, nf90_get_att(ncid, varid, 'standard_name', att))
         @assertEqual('sea_surface_height_above_mean_sea_level', trim(att))
         ! blank long_name must not have been written
         @assertFalse(NF90_NOERR == nf90_inquire_attribute(ncid, varid, 'long_name'))
         @assertEqual(NF90_NOERR, nf90_get_var(ncid, varid, glob, &
                                               start=[1, 1, 2], &
                                               count=[TEST_M, TEST_N, 1]))
         do j = 1, TEST_N
            do i = 1, TEST_M
               x = real(i - 1, SP)
               y = real(j - 1, SP)
               @assertEqual(2.0_SP*(2.0_SP*x + 3.0_SP*y), glob(i,j), tolerance=1e-12_SP)
            end do
         end do

         @assertEqual(NF90_NOERR, nf90_close(ncid))
         open (unit=99, file='./data.nc', status='old')
         close (99, status='delete')
      end if

      call reg%finalize()
      call dummy_fix_lint()
   end subroutine test_field_snapshot_netcdf

   ! ----------------------------------------------------------------
   ! station snapshot: values land in point order (point 1 lives on
   ! rank 1, point 2 on rank 0 — exercises the point_id re-sort),
   ! one "t v1 v2" row appended per flush
   ! ----------------------------------------------------------------
   @test(npes=[2])
   subroutine test_station_snapshot(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_comm)             :: comm
      type(type_grid_2d)          :: grid
      type(type_field_registry)   :: reg
      type(type_output_channel)   :: ch
      real(SP), allocatable, target :: eta(:,:)
      character(32) :: vars(1)
      character(8)  :: stats(1)
      real(SP) :: cx(2), cy(2), tval, v1, v2
      integer  :: unit

      call open_grid(this, grid, comm)
      call alloc_field(grid, eta)
      call fill_linear(grid, eta)
      call reg%register('eta', eta)

      ! point 1 at (5, 2) -> rank 1; point 2 at (2, 1) -> rank 0
      cx = [5.0_SP, 2.0_SP]
      cy = [2.0_SP, 1.0_SP]
      vars(1) = 'eta';  stats(1) = ''
      call ch%init(id='sta', geom_type='station', variables=vars, n_vars=1, &
                   statistics=stats, n_stats=0, snapshot=.true., &
                   t_start=0.0_SP, interval=1.0_SP, &
                   result_folder='./', format='ascii', &
                   coords_x=cx, coords_y=cy, n_coords=2, grid=grid, comm=comm)

      ! consecutive steps: the trigger accumulates dt (legacy
      ! PLOT_COUNT), so t must advance consistently with dt
      call ch%step(0.0_SP, 0.5_SP, reg, comm)
      call ch%step(0.5_SP, 0.5_SP, reg, comm)
      call ch%step(1.0_SP, 0.5_SP, reg, comm)

      if (comm%is_io_node()) then
         open (newunit=unit, file='./sta_eta.dat', status='old', action='read')
         read (unit, *) tval, v1, v2
         @assertEqual(0.0_SP, tval, tolerance=1e-6_SP)
         @assertEqual(2.0_SP*5.0_SP + 3.0_SP*2.0_SP, v1, tolerance=1e-4_SP)
         @assertEqual(2.0_SP*2.0_SP + 3.0_SP*1.0_SP, v2, tolerance=1e-4_SP)
         read (unit, *) tval, v1, v2
         @assertEqual(1.0_SP, tval, tolerance=1e-6_SP)
         close (unit, status='delete')
      end if

      call ch%finalize()
      call reg%finalize()
      call dummy_fix_lint()
   end subroutine test_station_snapshot

   ! ----------------------------------------------------------------
   ! field mean statistic: two accumulation windows; the second window
   ! averages two equal-dt samples -> (B + C) / 2 in eta_mean_00002
   ! ----------------------------------------------------------------
   @test(npes=[2])
   subroutine test_field_mean(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_comm)             :: comm
      type(type_grid_2d)          :: grid
      type(type_field_registry)   :: reg
      type(type_output_channel)   :: ch
      real(SP), allocatable, target :: eta(:,:)
      character(32) :: vars(1)
      character(8)  :: stats(1)
      real(SP) :: cx(1), cy(1), row(TEST_M)
      integer  :: j, unit

      call open_grid(this, grid, comm)
      call alloc_field(grid, eta)
      call reg%register('eta', eta)

      vars(1) = 'eta';  stats(1) = 'mean'
      cx = 0.0_SP;  cy = 0.0_SP
      call ch%init(id='avg_f', geom_type='field', variables=vars, n_vars=1, &
                   statistics=stats, n_stats=1, snapshot=.false., &
                   t_start=0.0_SP, interval=1.0_SP, &
                   result_folder='./', format='ascii', &
                   coords_x=cx, coords_y=cy, n_coords=0, grid=grid, comm=comm)

      eta = 2.0_SP
      call ch%step(0.0_SP, 0.5_SP, reg, comm)
      eta = 4.0_SP
      call ch%step(0.5_SP, 0.5_SP, reg, comm)
      eta = 8.0_SP
      call ch%step(1.0_SP, 0.5_SP, reg, comm)

      if (comm%is_io_node()) then
         ! window 1 (degenerate single sample at t=0) is dropped
         block
            logical :: exists
            inquire (file='./eta_mean_00001', exist=exists)
            @assertFalse(exists)
         end block

         ! window 2: samples 4 and 8 with equal dt
         open (newunit=unit, file='./eta_mean_00002', status='old', action='read')
         do j = 1, TEST_N
            read (unit, *) row
         end do
         close (unit, status='delete')
         @assertEqual(6.0_SP, row(TEST_M), tolerance=1e-4_SP)
      end if

      call ch%finalize()
      call reg%finalize()
      call dummy_fix_lint()
   end subroutine test_field_mean

   ! ----------------------------------------------------------------
   ! netcdf point channels: two groups share one diagnostics.nc — the
   ! snapshot group records every flush with cell_methods "time: point";
   ! the windowed group drops its degenerate first flush and carries
   ! time_bnds spanning each closed window
   ! ----------------------------------------------------------------
   @test(npes=[2])
   subroutine test_point_netcdf(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_comm)             :: comm
      type(type_grid_2d)          :: grid
      type(type_field_registry)   :: reg
      type(type_output_channel)   :: snap, win
      real(SP), allocatable, target :: eta(:,:)
      character(32) :: vars(1)
      character(8)  :: stats(1)
      character(64) :: att
      type(type_var_meta) :: vmeta(1)
      real(SP) :: cx(2), cy(2), t3(3), t2(2), vals(2), bnds(2,2)
      integer  :: diag, ncid, grp, dimid, varid, nlen

      call open_grid(this, grid, comm)
      call alloc_field(grid, eta)
      call fill_linear(grid, eta)
      call reg%register('eta', eta)

      diag = -1
      if (comm%is_io_node()) diag = open_diagnostics_file('./diagnostics.nc')

      ! point 1 at (5, 2) -> rank 1; point 2 at (2, 1) -> rank 0
      cx = [5.0_SP, 2.0_SP]
      cy = [2.0_SP, 1.0_SP]
      vars(1) = 'eta'
      vmeta(1)%units = 'm'
      stats(1) = ''
      call snap%init(id='snap_p', geom_type='station', variables=vars, n_vars=1, &
                     statistics=stats, n_stats=0, snapshot=.true., &
                     t_start=0.0_SP, interval=1.0_SP, &
                     result_folder='./', format='netcdf', &
                     coords_x=cx, coords_y=cy, n_coords=2, grid=grid, comm=comm, &
                     var_meta=vmeta, diag_ncid=diag)
      stats(1) = 'max'
      call win%init(id='win_p', geom_type='station', variables=vars, n_vars=1, &
                    statistics=stats, n_stats=1, snapshot=.false., &
                    t_start=0.0_SP, interval=1.0_SP, &
                    result_folder='./', format='netcdf', &
                    coords_x=cx, coords_y=cy, n_coords=2, grid=grid, comm=comm, &
                    var_meta=vmeta, diag_ncid=diag)

      ! walk t in dt steps (flushes at 0.0, 1.0, 2.0); eta rises by 1
      ! per step so each window's max is its last sample
      call snap%step(0.0_SP, 0.5_SP, reg, comm)
      call win%step(0.0_SP, 0.5_SP, reg, comm)
      eta = eta + 1.0_SP
      call snap%step(0.5_SP, 0.5_SP, reg, comm)
      call win%step(0.5_SP, 0.5_SP, reg, comm)
      eta = eta + 1.0_SP
      call snap%step(1.0_SP, 0.5_SP, reg, comm)
      call win%step(1.0_SP, 0.5_SP, reg, comm)
      eta = eta + 1.0_SP
      call snap%step(1.5_SP, 0.5_SP, reg, comm)
      call win%step(1.5_SP, 0.5_SP, reg, comm)
      eta = eta + 1.0_SP
      call snap%step(2.0_SP, 0.5_SP, reg, comm)
      call win%step(2.0_SP, 0.5_SP, reg, comm)

      call snap%finalize()
      call win%finalize()
      if (comm%is_io_node()) call close_diagnostics_file(diag)
      call comm%barrier()

      if (comm%is_io_node()) then
         @assertEqual(NF90_NOERR, nf90_open('./diagnostics.nc', NF90_NOWRITE, ncid))
         att = ''
         @assertEqual(NF90_NOERR, nf90_get_att(ncid, NF90_GLOBAL, 'Conventions', att))
         @assertEqual('CF-1.8', trim(att))

         ! snapshot group: 3 records, coords in point order, "time: point"
         @assertEqual(NF90_NOERR, nf90_inq_grp_ncid(ncid, 'snap_p', grp))
         @assertEqual(NF90_NOERR, nf90_inq_dimid(grp, 'point', dimid))
         @assertEqual(NF90_NOERR, nf90_inquire_dimension(grp, dimid, len=nlen))
         @assertEqual(2, nlen)
         @assertEqual(NF90_NOERR, nf90_inq_dimid(grp, 'time', dimid))
         @assertEqual(NF90_NOERR, nf90_inquire_dimension(grp, dimid, len=nlen))
         @assertEqual(3, nlen)
         @assertEqual(NF90_NOERR, nf90_inq_varid(grp, 'x', varid))
         @assertEqual(NF90_NOERR, nf90_get_var(grp, varid, vals))
         @assertEqual(5.0_SP, vals(1), tolerance=1e-12_SP)
         @assertEqual(2.0_SP, vals(2), tolerance=1e-12_SP)
         @assertEqual(NF90_NOERR, nf90_inq_varid(grp, 'time', varid))
         @assertEqual(NF90_NOERR, nf90_get_var(grp, varid, t3))
         @assertEqual(0.0_SP, t3(1), tolerance=1e-12_SP)
         @assertEqual(2.0_SP, t3(3), tolerance=1e-12_SP)
         ! snapshot channels carry no window bounds
         @assertFalse(NF90_NOERR == nf90_inq_varid(grp, 'time_bnds', varid))
         @assertEqual(NF90_NOERR, nf90_inq_varid(grp, 'eta', varid))
         att = ''
         @assertEqual(NF90_NOERR, nf90_get_att(grp, varid, 'cell_methods', att))
         @assertEqual('time: point', trim(att))
         att = ''
         @assertEqual(NF90_NOERR, nf90_get_att(grp, varid, 'units', att))
         @assertEqual('m', trim(att))
         ! record 3 at t=2: linear field + 4 increments
         @assertEqual(NF90_NOERR, nf90_get_var(grp, varid, vals, &
                                               start=[1, 3], count=[2, 1]))
         @assertEqual(2.0_SP*5.0_SP + 3.0_SP*2.0_SP + 4.0_SP, vals(1), tolerance=1e-4_SP)
         @assertEqual(2.0_SP*2.0_SP + 3.0_SP*1.0_SP + 4.0_SP, vals(2), tolerance=1e-4_SP)

         ! windowed group: first flush dropped -> 2 records with bounds
         @assertEqual(NF90_NOERR, nf90_inq_grp_ncid(ncid, 'win_p', grp))
         @assertEqual(NF90_NOERR, nf90_inq_dimid(grp, 'time', dimid))
         @assertEqual(NF90_NOERR, nf90_inquire_dimension(grp, dimid, len=nlen))
         @assertEqual(2, nlen)
         @assertEqual(NF90_NOERR, nf90_inq_varid(grp, 'time', varid))
         att = ''
         @assertEqual(NF90_NOERR, nf90_get_att(grp, varid, 'bounds', att))
         @assertEqual('time_bnds', trim(att))
         @assertEqual(NF90_NOERR, nf90_get_var(grp, varid, t2))
         @assertEqual(1.0_SP, t2(1), tolerance=1e-12_SP)
         @assertEqual(2.0_SP, t2(2), tolerance=1e-12_SP)
         @assertEqual(NF90_NOERR, nf90_inq_varid(grp, 'time_bnds', varid))
         @assertEqual(NF90_NOERR, nf90_get_var(grp, varid, bnds))
         @assertEqual(0.0_SP, bnds(1,1), tolerance=1e-12_SP)
         @assertEqual(1.0_SP, bnds(2,1), tolerance=1e-12_SP)
         @assertEqual(1.0_SP, bnds(1,2), tolerance=1e-12_SP)
         @assertEqual(2.0_SP, bnds(2,2), tolerance=1e-12_SP)
         @assertEqual(NF90_NOERR, nf90_inq_varid(grp, 'eta_max', varid))
         att = ''
         @assertEqual(NF90_NOERR, nf90_get_att(grp, varid, 'cell_methods', att))
         @assertEqual('time: maximum', trim(att))
         ! window (0, 1]: samples at +1 and +2 -> max = linear + 2
         @assertEqual(NF90_NOERR, nf90_get_var(grp, varid, vals, &
                                               start=[1, 1], count=[2, 1]))
         @assertEqual(2.0_SP*5.0_SP + 3.0_SP*2.0_SP + 2.0_SP, vals(1), tolerance=1e-4_SP)
         @assertEqual(2.0_SP*2.0_SP + 3.0_SP*1.0_SP + 2.0_SP, vals(2), tolerance=1e-4_SP)

         @assertEqual(NF90_NOERR, nf90_close(ncid))
         open (unit=99, file='./diagnostics.nc', status='old')
         close (99, status='delete')
      end if

      call reg%finalize()
      call dummy_fix_lint()
   end subroutine test_point_netcdf

   ! ----------------------------------------------------------------
   ! chunked field layout: chunk_window=1.0 rolls each flush into its
   ! own time-aligned file named <id>_<t0>-<t1>.nc covering [t0, t1)
   ! ----------------------------------------------------------------
   @test(npes=[2])
   subroutine test_field_chunked(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_comm)             :: comm
      type(type_grid_2d)          :: grid
      type(type_field_registry)   :: reg
      type(type_output_channel)   :: ch
      real(SP), allocatable, target :: eta(:,:)
      character(32) :: vars(1)
      character(8)  :: stats(1)
      character(*), parameter :: F2 = './chk_00000001.0-00000002.0.nc'
      real(SP) :: cx(1), cy(1), glob(TEST_M, TEST_N), tval(1)
      integer  :: ncid, varid, dimid, nlen
      logical  :: exists

      call open_grid(this, grid, comm)
      call alloc_field(grid, eta)
      call reg%register('eta', eta)

      vars(1) = 'eta';  stats(1) = ''
      cx = 0.0_SP;  cy = 0.0_SP
      call ch%init(id='chk', geom_type='field', variables=vars, n_vars=1, &
                   statistics=stats, n_stats=0, snapshot=.true., &
                   t_start=0.0_SP, interval=1.0_SP, &
                   result_folder='./', format='netcdf', &
                   coords_x=cx, coords_y=cy, n_coords=0, grid=grid, comm=comm, &
                   chunk_window=1.0_SP)

      eta = 3.0_SP
      call ch%step(0.0_SP, 0.5_SP, reg, comm)
      eta = 5.0_SP
      call ch%step(0.5_SP, 0.5_SP, reg, comm)
      call ch%step(1.0_SP, 0.5_SP, reg, comm)
      eta = 7.0_SP
      call ch%step(1.5_SP, 0.5_SP, reg, comm)
      call ch%step(2.0_SP, 0.5_SP, reg, comm)
      call ch%finalize()
      call comm%barrier()

      if (comm%is_io_node()) then
         inquire (file='./chk_00000000.0-00000001.0.nc', exist=exists)
         @assertTrue(exists)
         inquire (file='./chk_00000002.0-00000003.0.nc', exist=exists)
         @assertTrue(exists)

         ! middle chunk: exactly the t=1 frame with the then-current field
         @assertEqual(NF90_NOERR, nf90_open(F2, NF90_NOWRITE, ncid))
         @assertEqual(NF90_NOERR, nf90_inq_dimid(ncid, 'time', dimid))
         @assertEqual(NF90_NOERR, nf90_inquire_dimension(ncid, dimid, len=nlen))
         @assertEqual(1, nlen)
         @assertEqual(NF90_NOERR, nf90_inq_varid(ncid, 'time', varid))
         @assertEqual(NF90_NOERR, nf90_get_var(ncid, varid, tval))
         @assertEqual(1.0_SP, tval(1), tolerance=1e-12_SP)
         @assertEqual(NF90_NOERR, nf90_inq_varid(ncid, 'eta', varid))
         @assertEqual(NF90_NOERR, nf90_get_var(ncid, varid, glob, &
                                               start=[1, 1, 1], &
                                               count=[TEST_M, TEST_N, 1]))
         @assertEqual(5.0_SP, glob(1, 1), tolerance=1e-12_SP)
         @assertEqual(NF90_NOERR, nf90_close(ncid))

         open (unit=99, file='./chk_00000000.0-00000001.0.nc', status='old')
         close (99, status='delete')
         open (unit=99, file=F2, status='old')
         close (99, status='delete')
         open (unit=99, file='./chk_00000002.0-00000003.0.nc', status='old')
         close (99, status='delete')
      end if

      call reg%finalize()
      call dummy_fix_lint()
   end subroutine test_field_chunked

   ! ----------------------------------------------------------------
   ! single layout: the field stream becomes a group in the shared
   ! root beside point-channel groups; closing the channel leaves the
   ! root open (the manager owns it)
   ! ----------------------------------------------------------------
   @test(npes=[2])
   subroutine test_field_single_root(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_comm)             :: comm
      type(type_grid_2d)          :: grid
      type(type_field_registry)   :: reg
      type(type_output_channel)   :: ch
      real(SP), allocatable, target :: eta(:,:)
      character(32) :: vars(1)
      character(8)  :: stats(1)
      real(SP) :: cx(1), cy(1), glob(TEST_M, TEST_N)
      integer  :: diag, ncid, grp, varid, dimid, nlen

      call open_grid(this, grid, comm)
      call alloc_field(grid, eta)
      call reg%register('eta', eta)

      diag = -1
      if (comm%is_io_node()) diag = open_diagnostics_file('./output_root.nc')

      vars(1) = 'eta';  stats(1) = ''
      cx = 0.0_SP;  cy = 0.0_SP
      call ch%init(id='fld', geom_type='field', variables=vars, n_vars=1, &
                   statistics=stats, n_stats=0, snapshot=.true., &
                   t_start=0.0_SP, interval=1.0_SP, &
                   result_folder='./', format='netcdf', &
                   coords_x=cx, coords_y=cy, n_coords=0, grid=grid, comm=comm, &
                   diag_ncid=diag)

      eta = 4.0_SP
      call ch%step(0.0_SP, 0.5_SP, reg, comm)
      call ch%finalize()
      if (comm%is_io_node()) call close_diagnostics_file(diag)
      call comm%barrier()

      if (comm%is_io_node()) then
         @assertEqual(NF90_NOERR, nf90_open('./output_root.nc', NF90_NOWRITE, ncid))
         @assertEqual(NF90_NOERR, nf90_inq_grp_ncid(ncid, 'fld', grp))
         @assertEqual(NF90_NOERR, nf90_inq_dimid(grp, 'x', dimid))
         @assertEqual(NF90_NOERR, nf90_inquire_dimension(grp, dimid, len=nlen))
         @assertEqual(TEST_M, nlen)
         @assertEqual(NF90_NOERR, nf90_inq_varid(grp, 'eta', varid))
         @assertEqual(NF90_NOERR, nf90_get_var(grp, varid, glob, &
                                               start=[1, 1, 1], &
                                               count=[TEST_M, TEST_N, 1]))
         @assertEqual(4.0_SP, glob(TEST_M, TEST_N), tolerance=1e-12_SP)
         @assertEqual(NF90_NOERR, nf90_close(ncid))
         open (unit=99, file='./output_root.nc', status='old')
         close (99, status='delete')
      end if

      call reg%finalize()
      call dummy_fix_lint()
   end subroutine test_field_single_root

end module test_output_channel
