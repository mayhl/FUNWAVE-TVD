module test_yaml_units
   use pFUnit
   use core_yaml_file_mod, only: type_yaml_reader
   use core_comm_mod, only: type_comm, new_comm
   use core_constants_mod, only: SP
   implicit none

contains

   @test
   subroutine test_read_real_units()
      type(type_comm) :: comm
      type(type_yaml_reader) :: reader
      real(SP) :: val
      character(:), allocatable :: path
      
      ! Setup (assuming a yaml file exists with:
      ! time_val: 60
      ! time_obj:
      !   value: 2
      !   units: min
      ! )
      comm = new_comm(0)
      call reader%init('test_units.yaml', comm)

      ! Test scalar (assuming default units handled outside or unitless)
      call reader%read('time_val', val=val, dim='time')
      @mpiAssertEqual(60.0_SP, val, tolerance=1e-6_SP)

      ! Test object
      call reader%read('time_obj', val=val, dim='time')
      @mpiAssertEqual(120.0_SP, val, tolerance=1e-6_SP)

      call reader%finalize()
      call comm%finalize()
   end subroutine test_read_real_units

end module test_yaml_units
