! allow(E001)
module test_interpolation

   use mpi_f08
   use pFUnit
   use core_comm_mod,          only: type_comm, new_comm
   use core_grid_mod,          only: type_grid_2d
   use core_interpolation_mod, only: type_interpolator
   use core_constants_mod,     only: SP, N_GHOST, PI, R_EARTH

   implicit none

   ! M=10 splits evenly across 2 ranks (5 cols each); N=4
   integer,  parameter :: TEST_M  = 10
   integer,  parameter :: TEST_N  = 4
   real(SP), parameter :: TEST_DX = 5.0_SP
   real(SP), parameter :: TEST_DY = 10.0_SP

   ! Rank 0: x in [0, 25)   — x(1)=0, x(5)=20; owns cell 5 via right ghost
   ! Rank 1: x in [25, 45]  — x(1)=25, x(5)=45 (shore boundary, inclusive)
   ! Both:   y in [0, 30]   — y(1)=0, y(4)=30   (ny_proc=1, both boundaries)
   !
   ! src_i/src_j are ghost-inclusive: interior index li + N_GHOST.
   ! Query point at local cell (2,2) → src_i = 2 + N_GHOST, src_j = 2 + N_GHOST.
   !
   ! Ghost-inclusive field: allocate (local_nx + 2*N_GHOST, local_ny + 2*N_GHOST).
   ! Interior values start at index N_GHOST+1.

contains

   subroutine dummy_fix_lint()
   end subroutine dummy_fix_lint

   subroutine open_grid(this, grid, comm)
      class(MpiTestMethod), intent(inout) :: this
      type(type_grid_2d),   intent(inout) :: grid
      type(type_comm),      intent(inout) :: comm
      type(MPI_Comm) :: mcomm

      mcomm = this%getMpiCommunicator()
      comm  = new_comm(io_rank_id=0, comm_id=mcomm)

      grid%M       = TEST_M
      grid%N       = TEST_N
      grid%nx_proc = 2
      grid%ny_proc = 1
      call grid%setup(comm, create_partition=.false.)
      call grid%init_spacing(dx0=TEST_DX, dy0=TEST_DY, x0=0.0_SP, y0=0.0_SP)
   end subroutine open_grid

   ! ----------------------------------------------------------------
   ! Query point outside entire domain → n_points = 0 on all ranks
   ! ----------------------------------------------------------------
   @test(npes=[2])
   subroutine test_init_no_points(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_grid_2d)      :: grid
      type(type_comm)         :: comm
      type(type_interpolator) :: interp
      real(SP) :: xq(1), yq(1)

      call open_grid(this, grid, comm)

      xq(1) = 999.0_SP
      yq(1) = 999.0_SP
      call interp%init(xq, yq, grid)

      @mpiAssertEqual(0, interp%n_points)

      call dummy_fix_lint()
   end subroutine test_init_no_points

   ! ----------------------------------------------------------------
   ! One point per rank; verify local count, ghost-inclusive cell indices,
   ! and weights.
   !   Rank 0: (7.5, 15.0) → interior cell (2,2), src = (2+NG, 2+NG)
   !   Rank 1: (32.5, 15.0) → interior cell (2,2), src = (2+NG, 2+NG)
   !   alpha = (7.5 - x(2,1)) / dx0 = (7.5-5)/5 = 0.5
   !   beta  = (15.0 - y(1,2)) / dy0 = (15-10)/10 = 0.5
   ! ----------------------------------------------------------------
   @test(npes=[2])
   subroutine test_init_domain_split(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_grid_2d)      :: grid
      type(type_comm)         :: comm
      type(type_interpolator) :: interp
      real(SP) :: xq(3), yq(3)
      integer  :: expected_src

      call open_grid(this, grid, comm)

      xq = [7.5_SP,   32.5_SP, 999.0_SP]
      yq = [15.0_SP, 15.0_SP,  999.0_SP]
      call interp%init(xq, yq, grid)

      expected_src = 2 + N_GHOST

      @mpiAssertEqual(1, interp%n_points)
      @mpiAssertEqual(expected_src, interp%src_i(1))
      @mpiAssertEqual(expected_src, interp%src_j(1))
      @mpiAssertEqual(0.5_SP, interp%alpha(1), tolerance=1e-6_SP)
      @mpiAssertEqual(0.5_SP, interp%beta(1),  tolerance=1e-6_SP)

      ! point_id: rank 0 → global point 1, rank 1 → global point 2
      @mpiAssertEqual(grid%iproc + 1, interp%point_id(1))

      call dummy_fix_lint()
   end subroutine test_init_domain_split

   ! ----------------------------------------------------------------
   ! Bilinear arithmetic with ghost-inclusive field.
   ! field(i,j) = i+j (interior); alpha=beta=0.5 at local cell (2,2).
   !   out = 0.25*(f(2,2)+f(3,2)+f(2,3)+f(3,3)) = 0.25*(4+5+5+6) = 5.0
   ! ----------------------------------------------------------------
   @test(npes=[2])
   subroutine test_gather_values(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_grid_2d)      :: grid
      type(type_comm)         :: comm
      type(type_interpolator) :: interp
      real(SP), allocatable   :: field(:,:), out(:)
      real(SP) :: xq(2), yq(2)
      integer  :: i, j, ng

      call open_grid(this, grid, comm)

      xq = [7.5_SP, 32.5_SP]
      yq = [15.0_SP, 15.0_SP]
      call interp%init(xq, yq, grid)

      ng = N_GHOST
      allocate(field(grid%local_nx + 2*ng, grid%local_ny + 2*ng))
      allocate(out(interp%n_points))

      field = 0.0_SP
      do j = 1, grid%local_ny
         do i = 1, grid%local_nx
            field(i+ng, j+ng) = real(i + j, SP)
         end do
      end do

      call interp%gather(field, out)

      @mpiAssertEqual(5.0_SP, out(1), tolerance=1e-5_SP)

      call dummy_fix_lint()
   end subroutine test_gather_values

   ! ----------------------------------------------------------------
   ! Point exactly at a grid node: alpha=0, beta=0 → out = field at node.
   ! Node at local (2,2): field(i,j)=i*10+j → field(2,2)=22.
   !   Rank 0: xq=5.0  → x(2,1)=5,  alpha=0
   !   Rank 1: xq=30.0 → x(2,1)=30, alpha=0
   ! ----------------------------------------------------------------
   @test(npes=[2])
   subroutine test_gather_at_node(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_grid_2d)      :: grid
      type(type_comm)         :: comm
      type(type_interpolator) :: interp
      real(SP), allocatable   :: field(:,:), out(:)
      real(SP) :: xq(2), yq(2)
      integer  :: i, j, ng

      call open_grid(this, grid, comm)

      xq = [5.0_SP, 30.0_SP]
      yq = [10.0_SP, 10.0_SP]
      call interp%init(xq, yq, grid)

      ng = N_GHOST
      allocate(field(grid%local_nx + 2*ng, grid%local_ny + 2*ng))
      allocate(out(interp%n_points))

      field = 0.0_SP
      do j = 1, grid%local_ny
         do i = 1, grid%local_nx
            field(i+ng, j+ng) = real(i*10 + j, SP)
         end do
      end do

      call interp%gather(field, out)

      @mpiAssertEqual(22.0_SP, out(1), tolerance=1e-5_SP)

      call dummy_fix_lint()
   end subroutine test_gather_at_node

   ! ----------------------------------------------------------------
   ! finalize: n_points reset and arrays deallocated
   ! ----------------------------------------------------------------
   @test(npes=[2])
   subroutine test_finalize(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_grid_2d)      :: grid
      type(type_comm)         :: comm
      type(type_interpolator) :: interp
      real(SP) :: xq(2), yq(2)

      call open_grid(this, grid, comm)

      xq = [7.5_SP, 32.5_SP]
      yq = [15.0_SP, 15.0_SP]
      call interp%init(xq, yq, grid)

      call interp%finalize()

      @mpiAssertEqual(0, interp%n_points)
      @assertFalse(allocated(interp%src_i))
      @assertFalse(allocated(interp%alpha))
      @assertFalse(allocated(interp%point_id))

      call dummy_fix_lint()
   end subroutine test_finalize

   ! ----------------------------------------------------------------
   ! Variable spacing: rank 0 dx=1, rank 1 dx=2, dy=1 everywhere.
   !   Rank 0: x=[0,1,2,3,4]; rank 1: x=[5,7,9,11,13].
   !   Query at (5.5, 0.5): owned by rank 1, cell (1,1).
   !   alpha = (5.5 - 5.0) / 2.0 = 0.25
   !   beta  = (0.5 - 0.0) / 1.0 = 0.5
   ! ----------------------------------------------------------------
   @test(npes=[2])
   subroutine test_variable_spacing_alpha(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_grid_2d)      :: grid
      type(type_comm)         :: comm
      type(type_interpolator) :: interp
      type(MPI_Comm) :: mcomm
      real(SP), allocatable :: dx(:,:), dy(:,:)
      real(SP) :: xq(1), yq(1)

      mcomm = this%getMpiCommunicator()
      comm  = new_comm(io_rank_id=0, comm_id=mcomm)

      grid%M = 10; grid%N = 4
      grid%nx_proc = 2; grid%ny_proc = 1
      call grid%setup(comm, create_partition=.false.)

      allocate(dx(grid%local_nx, grid%local_ny))
      allocate(dy(grid%local_nx, grid%local_ny))
      if (grid%iproc == 0) then
         dx = 1.0_SP
      else
         dx = 2.0_SP
      end if
      dy = 1.0_SP
      call grid%init_spacing(dx, dy)

      xq(1) = 5.5_SP
      yq(1) = 0.5_SP
      call interp%init(xq, yq, grid)

      if (grid%iproc == 0) then
         @assertEqual(0, interp%n_points)
      else
         @assertEqual(1,      interp%n_points)
         @assertEqual(0.25_SP, interp%alpha(1), tolerance=1e-6_SP)
         @assertEqual(0.5_SP,  interp%beta(1),  tolerance=1e-6_SP)
      end if

      call dummy_fix_lint()
   end subroutine test_variable_spacing_alpha

   ! ----------------------------------------------------------------
   ! Spherical grid: alpha uses dx at the query row (lj), not row 1.
   !   lat0=60°, dlon=1°, dlat=1°; query at row lj=3 (lat 62°).
   !   dx(i,3) = R_EARTH*cos(62°*PI/180)*PI/180 ≠ dx(i,1).
   !   alpha_expected = 0.5*cos(60°)/cos(62°) ≠ 0.5.
   !   Only rank 0 (ibegin=1) owns xq=1.5*dx_ref; rank 1 (ibegin=6) does not.
   ! ----------------------------------------------------------------
   @test(npes=[2])
   subroutine test_spherical_alpha(this)
      class(MpiTestMethod), intent(inout) :: this
      type(type_grid_2d)      :: grid
      type(type_comm)         :: comm
      type(type_interpolator) :: interp
      type(MPI_Comm) :: mcomm
      real(SP) :: xq(1), yq(1), dx_ref, dy_val, alpha_expected
      real(SP), parameter :: DLON = 1.0_SP, DLAT = 1.0_SP, LON0 = 0.0_SP, LAT0 = 60.0_SP

      mcomm = this%getMpiCommunicator()
      comm  = new_comm(io_rank_id=0, comm_id=mcomm)
      grid%M = 10; grid%N = 6
      grid%nx_proc = 2; grid%ny_proc = 1
      call grid%setup(comm, create_partition=.false.)
      call grid%init_spacing_spherical(DLON, DLAT, LON0, LAT0)

      dx_ref = R_EARTH * cos(LAT0 * PI / 180.0_SP) * DLON * PI / 180.0_SP
      dy_val = R_EARTH * DLAT * PI / 180.0_SP

      ! Midpoint in x-direction (li=2) and midpoint within row lj=3
      xq(1) = 1.5_SP * dx_ref
      yq(1) = 2.5_SP * dy_val

      call interp%init(xq, yq, grid)

      if (grid%iproc == 0) then
         alpha_expected = 0.5_SP * cos(LAT0 * PI / 180.0_SP) &
                        / cos((LAT0 + 2.0_SP*DLAT) * PI / 180.0_SP)
         @assertEqual(1, interp%n_points)
         @assertEqual(alpha_expected, interp%alpha(1), tolerance=1e-5_SP)
         @assertEqual(0.5_SP, interp%beta(1), tolerance=1e-5_SP)
      end if
      if (grid%iproc == 1) then
         @assertEqual(0, interp%n_points)
      end if

      call dummy_fix_lint()
   end subroutine test_spherical_alpha

end module test_interpolation
