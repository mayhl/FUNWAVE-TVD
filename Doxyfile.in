DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/doc"
INPUT                  = "@PROJECT_SOURCE_DIR@/src" 
FILE_PATTERNS          = *.f90 *.F90 *.f *.F *.c *.h 
RECURSIVE              = YES
EXCLUDE                = */test/* */tests/*
OPTIMIZE_FOR_FORTRAN   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
ENABLE_PREPROCESSING   = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
CITE_BIB_FILES         = @PROJECT_SOURCE_DIR@/docs/references.bib
GENERATE_MAN           = NO
STRIP_CODE_COMMENTS    = NO
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = @AWESOME_CSS_DIR@/doxygen-awesome.css \
                         @PROJECT_SOURCE_DIR@/docs/doxygen-custom.css
HTML_EXTRA_FILES       = @PROJECT_SOURCE_DIR@/docs/doxygen-nav.js
HTML_FOOTER            = @PROJECT_SOURCE_DIR@/docs/doxygen-footer.html
INCLUDE_PATH           = "@PROJECT_SOURCE_DIR@/inc"
