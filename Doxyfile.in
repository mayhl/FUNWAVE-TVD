DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/doc"
INPUT                  = "@PROJECT_SOURCE_DIR@/src"
FILE_PATTERNS          = *.f90 *.F90 *.f *.F *.c *.h
RECURSIVE              = YES
EXCLUDE                = */test/* */tests/*
OPTIMIZE_FOR_FORTRAN   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
ENABLE_PREPROCESSING   = YES
PREDEFINED = _RANGE=type_integer_range _CLASS=integer _FMT="(I20)" _RANGE=type_real_range _CLASS=real(SP) _FMT=*
GENERATE_HTML          = YES
GENERATE_LATEX         = YES
GENERATE_MAN           = NO
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

GENERATE_TREEVIEW      = YES
DISABLE_INDEX = NO
FULL_SIDEBAR = NO
HTML_EXTRA_STYLESHEET  = @AWESOME_CSS_DIR@/doxygen-awesome.css
HTML_COLORSTYLE
INCLUDE_PATH = "@PROJECT_SOURCE_DIR@/inc"
